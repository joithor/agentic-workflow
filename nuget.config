<?xml version="1.0" encoding="utf-8"?>
<!-- NuGet supply chain (agent-readiness spec §4d, "NuGet and Node"):
     - nuget.org is the only source; every package id maps to it (package source mapping).
     - Every package must carry a valid nuget.org repository signature (signatureValidationMode=require).
       Restore applies this ONLY when signature verification is on (off by default on macOS; set
       DOTNET_NUGET_SIGNATURE_VERIFICATION=true) and ONLY to packages it extracts, so a warm package cache is
       never re-checked. The enforcement step is scripts/dotnet-verify-packages.sh (CI): it restores with
       verification on and runs `dotnet nuget verify` over every locked package against this file. One
       carve-out there: a package whose only failures are an expired signature (NU3037) or a timestamp from a
       since-distrusted authority (NU3028), which restore accepts, passes with a warning.
     - Lock files + locked restore in CI live in Directory.Build.props. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
  <config>
    <add key="signatureValidationMode" value="require" />
  </config>
  <trustedSigners>
    <!-- nuget.org repository signing certificates (SHA-256), current first. The current one was read from a
         package with `dotnet nuget verify` (all signatures, normal verbosity); the older two still sign older packages. -->
    <repository name="nuget.org" serviceIndex="https://api.nuget.org/v3/index.json">
      <certificate fingerprint="1F4B311D9ACC115C8DC8018B5A49E00FCE6DA8E2855F9F014CA6F34570BC482D" hashAlgorithm="SHA256" allowUntrustedRoot="false" />
      <certificate fingerprint="5A2901D6ADA3D18260B9C6DFE2133C95D74B9EEF6AE0E5DC334C8454D1477DF4" hashAlgorithm="SHA256" allowUntrustedRoot="false" />
      <certificate fingerprint="0E5F38F57DC1BCC806D8494F4F90FBCEDD988B46760709CBEEC6F4219AA6157D" hashAlgorithm="SHA256" allowUntrustedRoot="false" />
    </repository>
  </trustedSigners>
</configuration>
