{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1,
      "description": "Profile format version"
    },
    "mode": {
      "type": "string",
      "enum": [
        "shadow",
        "assist",
        "auto-small"
      ],
      "default": "shadow",
      "description": "What sindri may do on its own (spec §7.1)"
    },
    "user": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,38}$",
      "description": "Namespace for claim refs sindri/<user>/<item> (spec §9.4)"
    },
    "hosts": {
      "type": "object",
      "properties": {
        "active": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "active"
      ],
      "additionalProperties": false,
      "description": "hosts.active: the one host allowed to run ticks"
    },
    "tracker": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "plan-file"
            },
            "repo": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,38}$",
              "description": "Repo (from repos) whose plan files are the backlog"
            },
            "glob": {
              "type": "string",
              "pattern": "^[^*]+\\/\\*\\.md$",
              "default": "docs/superpowers/plans/*.md"
            },
            "include": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9*._-]+$"
              },
              "minItems": 1,
              "default": [
                "*"
              ],
              "description": "Plan file names to read, with * wildcards, e.g. *-sindri-plan-*"
            }
          },
          "required": [
            "type",
            "repo"
          ],
          "additionalProperties": false
        }
      ],
      "description": "Where work items come from. Plan 2 ships type: plan-file"
    },
    "repos": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,38}$"
      },
      "minItems": 1,
      "description": "Repo names; each needs repos/<name>.yaml"
    },
    "trustedAuthors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": [],
      "description": "Author ids whose items may auto-start (spec §8.3). For plan-file these are git author emails, which anyone can forge; signed commits are required before auto-small"
    },
    "trustedBots": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": [],
      "description": "Bot ids whose review comments feed fix rounds"
    },
    "providers": {
      "type": "object",
      "properties": {
        "allowed": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "anthropic",
              "jev",
              "openai",
              "cursor"
            ]
          },
          "minItems": 1,
          "default": [
            "anthropic",
            "jev"
          ]
        }
      },
      "additionalProperties": false,
      "default": {},
      "description": "providers.allowed: model providers sindri may call (spec §6.1)"
    },
    "budget": {
      "type": "object",
      "properties": {
        "perItem": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "perDay": {
          "type": "integer",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false,
      "default": {},
      "description": "Token budgets; unset until rollout step 3a enforces them"
    },
    "autoStartMaxSize": {
      "type": "string",
      "enum": [
        "XS",
        "S",
        "M",
        "L",
        "XL"
      ],
      "default": "XS",
      "description": "Largest size auto-small may start"
    },
    "selfMerge": {
      "type": "string",
      "enum": [
        "human",
        "auto"
      ],
      "default": "human",
      "description": "Who merges toolkit PRs (spec §7.7); protected modules always wait for the human"
    },
    "scrub": {
      "type": "object",
      "properties": {
        "extraPatterns": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{1,30}$"
              },
              "regex": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "required": [
              "kind",
              "regex"
            ],
            "additionalProperties": false
          },
          "default": []
        }
      },
      "additionalProperties": false,
      "default": {},
      "description": "scrub.extraPatterns: extra secret shapes, added to the built-ins (never removes one)"
    },
    "index": {
      "type": "object",
      "properties": {
        "denyPaths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": [],
          "description": "Path globs the index never reads, case-insensitive (sensitive fixtures, generated code), added to the built-in secret globs (.env*, *.pem, **/secrets/** and the like)"
        },
        "utilityGlobs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": [],
          "description": "Globs of internal utility modules; their exports are reinvention candidates"
        },
        "maxFileKB": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "default": 512
        },
        "maxTotalMB": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "default": 200
        },
        "maxAgeHours": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "default": 24,
          "description": "An index older than this is stale (index status and doctor warn)"
        },
        "embeddings": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "url": {
              "type": "string",
              "default": "http://127.0.0.1:11434"
            },
            "model": {
              "type": "string",
              "minLength": 1,
              "default": "nomic-embed-text"
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "graph": {
          "type": "string",
          "enum": [
            "graphify",
            "none"
          ],
          "default": "graphify"
        },
        "graphMaxMB": {
          "type": "integer",
          "minimum": 1,
          "maximum": 512,
          "default": 256,
          "description": "Largest graphify graph.json the index reads, in MB (max 512, the V8 string limit); a bigger one leaves the graph layer unavailable"
        }
      },
      "additionalProperties": false,
      "default": {},
      "description": "Code index (spec §6.2)"
    },
    "shape": {
      "type": "object",
      "properties": {
        "record": {
          "type": "boolean",
          "default": true,
          "description": "Record shape signals at commit (record-only until rollout step 3b); false turns the hook step off"
        },
        "budgetMs": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "default": 2000
        },
        "outcomeDays": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "default": 14,
          "description": "Days after a commit before its signals get an outcome label (kept, acted-on, dropped)"
        },
        "defaultSize": {
          "type": "string",
          "enum": [
            "XS",
            "S",
            "M",
            "L",
            "XL"
          ],
          "default": "S",
          "description": "Size class used for diff budgets when a commit has no item"
        },
        "thresholds": {
          "type": "object",
          "properties": {
            "nameSimilarity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "default": 0.85
            },
            "embedding": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "default": 0.9
            },
            "embeddingAst": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "default": 0.6
            },
            "nearCloneTokens": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "default": 60
            },
            "nearCloneJaccard": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "default": 0.8
            },
            "callOverlap": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "default": 0.5
            },
            "complexityDelta": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "default": 10
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "sizeBudget": {
          "type": "object",
          "properties": {
            "XS": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "default": 80
            },
            "S": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "default": 250
            },
            "M": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "default": 600
            },
            "L": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "default": 1200
            },
            "XL": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "default": 2400
            }
          },
          "additionalProperties": false,
          "default": {},
          "description": "Changed-line budget per size class"
        },
        "exportAllowance": {
          "type": "object",
          "properties": {
            "XS": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "default": 1
            },
            "S": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "default": 3
            },
            "M": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "default": 6
            },
            "L": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "default": 10
            },
            "XL": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "default": 20
            }
          },
          "additionalProperties": false,
          "default": {},
          "description": "New exports allowed per size class"
        }
      },
      "additionalProperties": false,
      "default": {},
      "description": "Shape signals (spec §6.2)"
    },
    "sources": {
      "type": "object",
      "properties": {
        "notesDir": {
          "type": "string",
          "description": "Your notes (vault) dir; scoping searches it"
        },
        "transcripts": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "dir": {
              "type": "string",
              "default": "~/.claude/projects"
            }
          },
          "additionalProperties": false,
          "default": {},
          "description": "Opt-in: human turns from your Claude Code sessions. Turns from unrelated projects can reach the model, so leave it off unless you want that"
        },
        "linear": {
          "type": "object",
          "properties": {
            "token": {
              "type": "string",
              "pattern": "^(env:[A-Za-z_][A-Za-z0-9_]*|file:\\/\\S+|keychain:[^/\\s]+\\/\\S+|op:\\S+\\/\\S+)$"
            },
            "apiUrl": {
              "type": "string",
              "format": "uri",
              "default": "https://api.linear.app/graphql"
            },
            "allowCustomApiUrl": {
              "type": "boolean",
              "default": false
            }
          },
          "required": [
            "token"
          ],
          "additionalProperties": false,
          "description": "Read-only Linear token for scoping and backtests"
        }
      },
      "additionalProperties": false,
      "default": {}
    },
    "models": {
      "type": "object",
      "properties": {
        "scoping": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:\\[\\]-]*$",
          "default": "sonnet"
        },
        "challenger": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:\\[\\]-]*$",
          "default": "opus"
        },
        "adjudicator": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:\\[\\]-]*$",
          "default": "opus"
        },
        "effort": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "default": "medium"
        },
        "allowBaseUrl": {
          "type": "boolean",
          "default": false,
          "description": "Let the claude child keep *_BASE_URL variables (they can reroute model traffic)"
        }
      },
      "additionalProperties": false,
      "default": {}
    },
    "evolve": {
      "type": "object",
      "properties": {
        "maxOpenProposals": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "default": 10,
          "description": "stage stops once this many proposals are staged or published and not yet merged"
        },
        "maxTokensPerJob": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "default": 600000,
          "description": "Token budget for one reflect, correct, telemetry or weekly step"
        },
        "maxTokensPerCompare": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "default": 3000000,
          "description": "Token budget for one offline comparison (about 100000 tokens per holdout item)"
        },
        "maxCorrectTurns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000,
          "default": 400,
          "description": "How many of the newest human turns `correct` sends to the labeling model per run (20 per call)"
        },
        "prAuthors": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9-]{1,39}$"
          },
          "default": [],
          "description": "GitHub logins whose merged PRs reflect may read; empty means only the authenticated gh user"
        }
      },
      "additionalProperties": false,
      "default": {}
    },
    "privacy": {
      "type": "object",
      "properties": {
        "denyTerms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 60
          },
          "maxItems": 500,
          "default": [],
          "description": "Workplace words that must never appear in a published proposal task (whole words, case-insensitive). Changing this list needs profile approval"
        }
      },
      "additionalProperties": false,
      "default": {}
    },
    "scope": {
      "type": "object",
      "properties": {
        "maxRounds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "default": 3
        },
        "maxTokensPerRun": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "default": 600000
        },
        "maxTokensPerBacktest": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "default": 1500000
        },
        "maxRecords": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "default": 40
        },
        "maxPackChars": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "default": 120000
        }
      },
      "additionalProperties": false,
      "default": {}
    }
  },
  "required": [
    "schemaVersion",
    "user",
    "hosts",
    "tracker",
    "repos"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Sindri profile.yaml"
}
