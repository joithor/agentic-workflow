<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for Aw.Analyzers: each rule runs on a small in-memory compilation (AnalyzerHarness) over the running
       runtime's reference assemblies, so the suite needs no network and no NuGet reference packs (spec §4b.5). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Aw.Analyzers.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Aw.Analyzers/Aw.Analyzers.csproj" />
    <ProjectReference Include="../Aw.Kernel.Testing/Aw.Kernel.Testing.csproj" />
  </ItemGroup>
</Project>
