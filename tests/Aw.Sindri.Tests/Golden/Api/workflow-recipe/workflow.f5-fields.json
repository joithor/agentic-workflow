        {
          "key": "fact:report",
          "label": "Report"
        }
      ]
    },
    {
      "id": "approve",
      "order": 3,
      "branchOf": null,
      "why": "You decide whether it goes on.",
      "displayName": "Approve the draft",
      "kind": "you",
      "onOutcome": [
        {
          "outcome": "approve",
          "text": "Moves on to the hand-over."
        },
        {
          "outcome": "revise",
          "text": "Sends your notes back to the AI."
        }
      ],
      "inputs": [
        {
          "key": "fact:report",
          "label": "Report"
        }
      ]
    },
    {
      "id": "confirm",
      "order": 4,
