      "label": "you asked for changes"
    }
  ],
  "why": "Takes a brief to an approved, handed-over report.",
  "transitions": [
    {
      "from": [
        "write"
      ],
      "on": "step.completed",
      "to": "check",
      "outcome": "done"
    },
    {
      "from": [
        "check"
      ],
      "on": "step.completed",
      "to": "approve",
      "outcome": "passed"
    },
    {
      "from": [
        "check"
      ],
      "on": "step.completed",
      "to": "write",
      "outcome": "failed",
      "label": "problems found: write it again"
    },
    {
      "from": [
        "approve"
      ],
      "on": "step.completed",
      "to": "confirm",
      "outcome": "approve"
    },
    {
      "from": [
        "approve"
      ],
      "on": "step.completed",
      "to": "write",
      "outcome": "revise",
      "label": "you asked for changes"
    },
    {
      "from": [
        "confirm"
      ],
      "on": "step.completed",
      "to": "handover",
      "outcome": "confirmed"
    },
    {
      "from": [
        "handover"
