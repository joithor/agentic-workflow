# Analyzer policy for test projects (agent-readiness spec §4b.5): everything under tests/, which holds the
# *.Tests projects and the *.Testing projects (fakes, builders, contract-test bases). Keep *.Testing projects
# here; outside tests/ this policy doesn't apply. Every other rule from the root .editorconfig still holds.
root = false

[*.cs]
# Test names use underscores (`StartItem_parks_when_budget_is_exhausted`, spec §4b.5).
dotnet_diagnostic.CA1707.severity = none
# xUnit1030 forbids ConfigureAwait(false) in tests, and fakes run on the test's context. The xUnit suppressor
# covers test methods only, not *.Testing code.
dotnet_diagnostic.CA2007.severity = none
# xUnit needs public test classes, and xUnit v3 test projects are Exe, which CA1515 analyzes. (*.Testing
# libraries aren't analyzed by CA1515; RS0016 is what would hit their public types, turned off below.)
dotnet_diagnostic.CA1515.severity = none
# Test code has no tracked public API (PublicAPI.*.txt are for library projects).
dotnet_diagnostic.RS0016.severity = none
dotnet_diagnostic.RS0017.severity = none
dotnet_diagnostic.RS0036.severity = none
dotnet_diagnostic.RS0037.severity = none
# No XML docs required in tests. GenerateDocumentationFile stays on (Directory.Build.props) so IDE0005 runs.
dotnet_diagnostic.CS1591.severity = none
# Forward the CancellationToken — owner: MA0040 (root .editorconfig). xUnit1051 reports the same call with
# TestContext.Current.CancellationToken as the fix (measured: both fired on one `await Task.Delay(1)`).
dotnet_diagnostic.xUnit1051.severity = none
# Style-guide rules that guard production lifetimes and SQL (root .editorconfig). Test code builds throwaway
# fixtures: xUnit owns the disposal of fixture fields (CA2000, CA2213 can't see it) and tests write literal setup SQL
# and table names of their own making (CA2100).
dotnet_diagnostic.CA2000.severity = none
dotnet_diagnostic.CA2213.severity = none
dotnet_diagnostic.CA2100.severity = none
