{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fixture.invalid/scoping/gold.schema.json",
  "title": "A scoping fixture gold file",
  "type": "object",
  "required": ["schemaVersion", "change", "tuning", "repo", "mustFind", "newSurfaces", "unmapped", "decoys", "behaviourGaps", "acceptance", "challenger"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "change": { "enum": ["expiry", "archive"] },
    "tuning": { "type": "boolean", "description": "false for the held-out change: never used to tune a seed" },
    "repo": { "type": "string" },
    "mustFind": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["key", "lens", "phase", "why"], "additionalProperties": false,
        "properties": {
          "key": { "type": "string", "description": "a map node key, a record key (linear:issue/<id>) or commit:<branch>" },
          "lens": { "enum": ["code", "product", "related", "history"] },
          "phase": { "enum": ["initial", "afterAnswers"] },
          "why": { "type": "string" }
        }
      }
    },
    "newSurfaces": {
      "type": "array",
      "items": { "type": "object", "required": ["key", "label", "implementsOn"], "additionalProperties": false,
        "properties": { "key": { "type": "string" }, "label": { "type": "string" }, "implementsOn": { "type": "string" } } }
    },
    "unmapped": {
      "type": "array",
      "items": { "type": "object", "required": ["path", "why"], "additionalProperties": false,
        "properties": { "path": { "type": "string" }, "why": { "type": "string" } } }
    },
    "decoys": {
      "type": "array",
      "items": { "type": "object", "required": ["key", "why"], "additionalProperties": false,
        "properties": { "key": { "type": "string" }, "why": { "type": "string" } } }
    },
    "behaviourGaps": {
      "type": "array", "minItems": 1,
      "items": { "type": "object", "required": ["id", "question", "options", "citations"], "additionalProperties": false,
        "properties": { "id": { "type": "string", "pattern": "^gap-" }, "question": { "type": "string" },
          "options": { "type": "array", "minItems": 2, "maxItems": 4, "items": { "type": "string" } },
          "citations": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "note": { "type": "string" } } }
    },
    "acceptance": {
      "type": "array", "minItems": 1,
      "items": { "type": "object", "required": ["id", "form", "text", "surfaces", "regression"], "additionalProperties": false,
        "properties": { "id": { "type": "string", "pattern": "^(AC|RG)-[0-9]+$" }, "form": { "enum": ["ubiquitous", "event", "state", "unwanted", "optional"] },
          "text": { "type": "string" }, "surfaces": { "type": "array", "items": { "type": "string" } },
          "regression": { "type": "boolean" }, "phase": { "enum": ["initial", "afterAnswers"] } } }
    },
    "challenger": { "type": "object", "required": ["plantedMissing", "note"], "additionalProperties": false,
      "properties": { "plantedMissing": { "type": "array", "items": { "type": "string" } }, "note": { "type": "string" } } },
    "injection": { "type": ["object", "null"] },
    "token": { "type": ["object", "null"] }
  }
}
