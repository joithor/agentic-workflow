  "items": [
    {
      "id": "AC-1",
      "text": "When a member shares a note and picks an expiry time, the system shall store that time on the new link.",
      "form": "event",
      "surfaces": [
        "surface:screen/share-dialog",
        "surface:route/links-create"
      ],
      "citations": [
        "S4",
        "S2"
      ],
      "trust": "untrusted",
      "status": "failing",
      "evidence": [],
      "parent": null
    },
    {
      "id": "AC-2",
      "text": "When someone opens a link after its expiry time, the system shall show that the link has expired and shall not return the note.",
      "form": "event",
      "surfaces": [
        "surface:route/link-resolve"
      ],
      "citations": [
        "S3"
      ],
      "trust": "untrusted",
      "status": "failing",
      "evidence": [],
      "parent": null
    },
    {
      "id": "AC-3",
      "text": "While a link has no expiry time, the system shall keep it valid until it is revoked or its note is deleted.",
      "form": "state",
      "surfaces": [
        "surface:route/link-resolve"
      ],
      "citations": [
        "S3"
      ],
      "trust": "untrusted",
      "status": "failing",
      "evidence": [],
      "parent": null
    },
    {
      "id": "AC-4",
      "text": "If the chosen expiry time is not in the future, the system shall refuse to create the link.",
      "form": "unwanted",
      "surfaces": [
        "surface:route/links-create"
      ],
      "citations": [
        "S2"
      ],
      "trust": "untrusted",
      "status": "failing",
      "evidence": [],
      "parent": null
    },
    {
      "id": "AC-5",
      "text": "While a link is revoked or expired, the system shall not return its note.",
      "form": "state",
      "surfaces": [
        "surface:route/link-resolve",
        "surface:route/links-revoke"
      ],
      "citations": [
        "S3",
        "S13"
      ],
      "trust": "untrusted",
      "status": "failing",
      "evidence": [],
      "parent": null
    },
    {
      "id": "AC-6",
      "text": "When the weekly digest is built, the system shall list the owner's links that expire within 7 days.",
      "form": "event",
      "surfaces": [
        "surface:api/weekly-digest-email",
        "surface:job/nightly"
      ],
      "citations": [
        "S17",
        "S19"
      ],
      "trust": "owner",
      "status": "failing",
      "evidence": [],
      "parent": null
    },
    {
      "id": "AC-7",
      "text": "If a link was created before this change, the system shall treat it as having no expiry time.",
      "form": "unwanted",
      "surfaces": [
        "surface:route/link-resolve"
      ],
      "citations": [
        "S3"
      ],
      "trust": "untrusted",
      "status": "failing",
      "evidence": [],
      "parent": null
    },
    {
      "id": "AC-8",
      "text": "When an editor revokes a link, the system shall stop returning its note, as it does today.",
      "form": "event",
      "surfaces": [
        "surface:route/links-revoke"
      ],
      "citations": [
        "S13"
      ],
      "trust": "untrusted",
      "status": "failing",
      "evidence": [],
      "parent": null
    },
    {
      "id": "AC-9",
      "text": "When the digest is built for a week with no changed note, the system shall send nothing.",
      "form": "event",
      "surfaces": [
        "surface:api/weekly-digest-email"
      ],
      "citations": [
        "S17"
      ],
      "trust": "untrusted",
      "status": "failing",
      "evidence": [],
      "parent": null
    },
    {
      "id": "AC-10",
      "text": "If a viewer tries to create a link, the system shall refuse, as it does today.",
      "form": "unwanted",
      "surfaces": [
        "surface:route/links-create"
      ],
      "citations": [
        "S2"
      ],
      "trust": "untrusted",
      "status": "failing",
      "evidence": [],
      "parent": null
    },
    {
      "id": "AC-11",
      "form": "event",
      "text": "When a team's notes are exported, the system shall produce the same output as before this change, whether or not a note has a link with an expiry time.",
      "surfaces": [
        "surface:route/export-download"
      ],
      "citations": [
        "sec-4"
      ],
      "trust": "untrusted",
      "status": "failing",
