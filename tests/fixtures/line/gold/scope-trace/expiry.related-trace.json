{
  "feature:audit-report": {
    "depth": 1,
    "path": [
      "surface:route/links-create",
      "owns action:sharing.create-link",
      "writes thing:audit-entry",
      "reads action:audit.report"
    ]
  },
  "feature:sharing": {
    "depth": 1,
    "path": [
      "surface:route/links-create",
      "owns action:sharing.create-link",
      "writes thing:shared-link",
      "reads action:sharing.resolve-link"
    ]
  }
}
