{
  "kind": "lenses",
  "id": "design-five",
  "version": "1.0.0",
  "applies": "design",
  "lenses": [
    {
      "id": "product",
      "title": "Product",
      "prompt": "lenses/product.md",
      "when": "always"
    },
    {
      "id": "architecture",
      "title": "Architecture",
      "prompt": "lenses/architecture.md",
      "when": "always"
    },
    {
      "id": "design",
      "title": "Design",
      "prompt": "lenses/design.md",
      "when": {
        "surfaceKinds": [
          "screen",
          "dialog"
        ]
      }
    },
    {
      "id": "devex",
      "title": "Developer experience",
      "prompt": "lenses/devex.md",
      "when": {
        "surfaceKinds": [
          "route",
          "api"
        ]
      }
    },
    {
      "id": "security",
      "title": "Security",
      "prompt": "lenses/security.md",
      "when": "always"
    }
  ]
}
