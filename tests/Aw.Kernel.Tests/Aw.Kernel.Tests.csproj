<Project Sdk="Microsoft.NET.Sdk">
  <!-- xUnit v3 on Microsoft.Testing.Platform (global.json "test.runner"). Lanes are traits:
       `dotnet test` with filter-trait Lane=unit (spec §4b.5, §4e B13). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Aw.Kernel.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <!-- Example ids for the typed-id converters and guard (decision R9). -->
    <PackageReference Include="Vogen" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Aw.Kernel/Aw.Kernel.csproj" />
  </ItemGroup>

</Project>
