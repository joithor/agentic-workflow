<Project Sdk="Microsoft.NET.Sdk">
  <!-- xUnit v3 on Microsoft.Testing.Platform (global.json "test.runner"). Lanes are traits:
       `dotnet test` with filter-trait Lane=unit (spec §4b.5, §4e B13). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Aw.Kernel.Tests</RootNamespace>
    <!-- IDE0005 (unused usings) only runs with a documentation file; tests/.editorconfig turns off CS1591. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Aw.Kernel/Aw.Kernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Golden/*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
