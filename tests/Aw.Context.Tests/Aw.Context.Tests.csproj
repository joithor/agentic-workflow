<Project Sdk="Microsoft.NET.Sdk">
  <!-- Aw.Context.Tests (scaffolded by /new-package): by feature, one Lane trait per test (spec §4b.5). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Aw.Context.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Context/Aw.Context.Core/Aw.Context.Core.csproj" />
    <ProjectReference Include="../../src/Context/Aw.Context.Features/Aw.Context.Features.csproj" />
    <ProjectReference Include="../../src/Context/Aw.Context.Infrastructure/Aw.Context.Infrastructure.csproj" />
    <ProjectReference Include="../Aw.Context.Testing/Aw.Context.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Golden files (Aw.Kernel.Testing Golden) live in this project's source tree. -->
    <AssemblyMetadata Include="AwGoldenSourceRoot" Value="$(MSBuildProjectDirectory)" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tabs map the lenses tests read (S-4): copied beside the test assembly. -->
    <None Include="Fixtures/map-tabs.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
