<Project Sdk="Microsoft.NET.Sdk">
  <!-- Aw.Kernel.Data tests: the integration lane, on real temp SQLite files (spec §4b.5). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Aw.Kernel.Data.Tests</RootNamespace>
    <!-- IDE0005 (unused usings) only runs with a documentation file; tests/.editorconfig turns off CS1591. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Aw.Kernel.Data/Aw.Kernel.Data.csproj" />
    <!-- The shared contract bases (test-support: no deps.yaml edge needed, spec §4b.5). -->
    <ProjectReference Include="../Aw.Kernel.Testing/Aw.Kernel.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Migrations/**/*.sql" />
  </ItemGroup>
</Project>
