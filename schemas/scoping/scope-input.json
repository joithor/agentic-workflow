{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jthorare/agentic-workflow/schemas/scoping/scope-input.json",
  "title": "What to scope (fact:scopeInput)",
  "description": "The input of workflow.scoping: one of four shapes told apart by kind (scoping spec section 4 table).",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "brief"
        },
        "repo": {
          "type": "string",
          "minLength": 1,
          "description": "The repo the item belongs to."
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "section": {
          "type": "string",
          "minLength": 1,
          "description": "One \"## N.\" heading of the file."
        }
      },
      "required": [
        "kind",
        "repo",
        "path"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "tracker"
        },
        "repo": {
          "type": "string",
          "minLength": 1,
          "description": "The repo the item belongs to."
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "description": "A project or issue key in the tracker the profile configures."
        }
      },
      "required": [
        "kind",
        "repo",
        "key"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "idea"
        },
        "repo": {
          "type": "string",
          "minLength": 1,
          "description": "The repo the item belongs to."
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        }
      },
      "required": [
        "kind",
        "repo",
        "text"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "change"
        },
        "repo": {
          "type": "string",
          "minLength": 1,
          "description": "The repo the item belongs to."
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "description": "A PR number or a branch name."
        }
      },
      "required": [
        "kind",
        "repo",
        "ref"
      ],
      "additionalProperties": false
    }
  ]
}
