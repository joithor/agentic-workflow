{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jthorare/agentic-workflow/schemas/scoping/challenge-round.json",
  "title": "One challenger round (fact:challengeRound)",
  "description": "Spec A.4: \"this round only ... walked[] (lenses and dimensions) and the verdict, nothingNew, or found with new surfaces (with citations) and new behaviours (with the question each raises)\". step.scope.challenge-log fails the Step when the verdict and the items disagree.",
  "type": "object",
  "properties": {
    "walked": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "lens",
              "dimension"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "surface": {
            "type": "string",
            "pattern": "^S[1-9][0-9]*$",
            "description": "A surface id in the scope map."
          }
        },
        "required": [
          "kind",
          "name"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "description": "Spec A.4/B.2 \"walked[] (lenses and dimensions)\": one entry per lens or dimension walked (SCP-CHAL-001: \"lists every lens and dimension it walked\")."
    },
    "verdict": {
      "enum": [
        "nothingNew",
        "found"
      ]
    },
    "surfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "citations": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(R[1-9][0-9]*|A[1-9][0-9]*|L-(code|product|related|history)-[1-9][0-9]*)$"
            },
            "description": "Ids that resolve (SCP-CITE-001): a lens item L-<lens>-<n>, a source ref R<n> in fact:brief.refs, or an answer A<n> in the answer log.",
            "minItems": 1
          }
        },
        "required": [
          "title",
          "citations"
        ],
        "additionalProperties": false
      }
    },
    "behaviours": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "citations": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(R[1-9][0-9]*|A[1-9][0-9]*|L-(code|product|related|history)-[1-9][0-9]*)$"
            },
            "description": "Ids that resolve (SCP-CITE-001): a lens item L-<lens>-<n>, a source ref R<n> in fact:brief.refs, or an answer A<n> in the answer log.",
            "minItems": 1
          }
        },
        "required": [
          "text",
          "question",
          "citations"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "walked",
    "verdict"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "found"
          }
        },
        "required": [
          "verdict"
        ]
      },
      "then": {
        "anyOf": [
          {
            "required": [
              "surfaces"
            ],
            "properties": {
              "surfaces": {
                "minItems": 1
              }
            }
          },
          {
            "required": [
              "behaviours"
            ],
            "properties": {
              "behaviours": {
                "minItems": 1
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "nothingNew"
          }
        },
        "required": [
          "verdict"
        ]
      },
      "then": {
        "properties": {
          "surfaces": {
            "maxItems": 0
          },
          "behaviours": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
