{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jthorare/agentic-workflow/schemas/scoping/acceptance.json",
  "title": "Acceptance list (fact:acceptance and acceptance.json)",
  "description": "Spec 8.3 acceptance.json: \"The items: id, text, form, surfaces, citations, trust, status: failing, evidence: [], parent: null\". The fact form ({ items }) forbids trust (SCP-TRUST-001); the packet-file form (schemaVersion present) carries it, with the optional parent.",
  "$defs": {
    "fact": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^AC-[1-9][0-9]*$",
                "description": "An acceptance item id (spec 7.3: blocks [\"AC-4\"]). The answer-log id is A<n>."
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "form": {
                "enum": [
                  "ears",
                  "plain"
                ],
                "description": "SCP-ACC-001: form: ears, or form: plain with a reason."
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "description": "Required with form plain: what is missing."
              },
              "surfaces": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^S[1-9][0-9]*$",
                  "description": "A surface id in the scope map."
                }
              },
              "citations": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^(R[1-9][0-9]*|A[1-9][0-9]*|L-(code|product|related|history)-[1-9][0-9]*)$"
                },
                "description": "Ids that resolve (SCP-CITE-001): a lens item L-<lens>-<n>, a source ref R<n> in fact:brief.refs, or an answer A<n> in the answer log.",
                "minItems": 1
              },
              "option": {
                "type": "string",
                "minLength": 1,
                "description": "Spec 7.4: the option id an answer chose (Q3.a)."
              },
              "status": {
                "const": "failing"
              },
              "evidence": {
                "type": "array",
                "maxItems": 0
              },
              "parent": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "id",
              "text",
              "form",
              "surfaces",
              "citations"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "form": {
                      "const": "plain"
                    }
                  },
                  "required": [
                    "form"
                  ]
                },
                "then": {
                  "required": [
                    "reason"
                  ]
                }
              }
            ]
          }
        }
      },
      "required": [
        "items"
      ],
      "additionalProperties": false
    },
    "file": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1,
          "description": "Packet-file envelope: present in the file written to the scope packet (aw-packets: every JSON file carries schemaVersion 1), absent in the fact."
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^AC-[1-9][0-9]*$",
                "description": "An acceptance item id (spec 7.3: blocks [\"AC-4\"]). The answer-log id is A<n>."
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "form": {
                "enum": [
                  "ears",
                  "plain"
                ],
                "description": "SCP-ACC-001: form: ears, or form: plain with a reason."
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "description": "Required with form plain: what is missing."
              },
              "surfaces": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^S[1-9][0-9]*$",
                  "description": "A surface id in the scope map."
                }
              },
              "citations": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^(R[1-9][0-9]*|A[1-9][0-9]*|L-(code|product|related|history)-[1-9][0-9]*)$"
                },
                "description": "Ids that resolve (SCP-CITE-001): a lens item L-<lens>-<n>, a source ref R<n> in fact:brief.refs, or an answer A<n> in the answer log.",
                "minItems": 1
              },
              "option": {
                "type": "string",
                "minLength": 1,
                "description": "Spec 7.4: the option id an answer chose (Q3.a)."
              },
              "status": {
                "const": "failing"
              },
              "evidence": {
                "type": "array",
                "maxItems": 0
              },
              "parent": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "trust": {
                "enum": [
                  "untrusted",
                  "owner"
                ],
                "description": "Stamped by code (SCP-TRUST-001). The spec 7.3 example carries it on a question; a draft-stage model-written value is a finding, so it is optional here."
              }
            },
            "required": [
              "id",
              "text",
              "form",
              "surfaces",
              "citations"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "form": {
                      "const": "plain"
                    }
                  },
                  "required": [
                    "form"
                  ]
                },
                "then": {
                  "required": [
                    "reason"
                  ]
                }
              }
            ]
          }
        },
        "parent": {
          "type": [
            "string",
            "null"
          ],
          "description": "Packet-file envelope: the scope packet hash this file extends, or null."
        }
      },
      "required": [
        "items"
      ],
      "additionalProperties": false
    }
  },
  "if": {
    "type": "object",
    "required": [
      "schemaVersion"
    ]
  },
  "then": {
    "$ref": "#/$defs/file"
  },
  "else": {
    "$ref": "#/$defs/fact"
  }
}
