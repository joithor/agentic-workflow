{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jthorare/agentic-workflow/schemas/scoping/questions.json",
  "title": "Interview questions (fact:questions)",
  "description": "A batch of at most five questions with two to four exclusive options each; every option cites (scoping spec section 7.3, A.2, A.5). Question ids are unique within the batch.",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "text": {
        "type": "string",
        "minLength": 1
      },
      "dimension": {
        "type": "string"
      },
      "options": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "rationale": {
              "type": "string"
            },
            "citations": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^(R[0-9]+|A[0-9]+|L-(code|product|related|history)-[0-9]+)$"
              }
            },
            "yields": {
              "type": "string"
            },
            "recommended": {
              "type": "boolean"
            }
          },
          "required": [
            "id",
            "label",
            "citations"
          ],
          "additionalProperties": false
        },
        "minItems": 2,
        "maxItems": 4
      }
    },
    "required": [
      "id",
      "text",
      "options"
    ],
    "additionalProperties": false
  },
  "maxItems": 5,
  "uniqueItems": true
}
