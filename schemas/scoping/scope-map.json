{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jthorare/agentic-workflow/schemas/scoping/scope-map.json",
  "title": "Scope map (fact:scopeMap and scope-map.json)",
  "description": "Spec 8.3 scope-map.json: \"Surfaces (kind, title, detail, citations, trust, lens, graph status ...), implications, workstreams with dependencies, flagged, excluded, unmapped, and unresolved\". One schema for the fact and the packet file: the file adds the optional envelope schemaVersion, change and baseSha.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1,
      "description": "Packet-file envelope: present in the file written to the scope packet (aw-packets: every JSON file carries schemaVersion 1), absent in the fact."
    },
    "change": {
      "type": "string",
      "minLength": 1,
      "description": "Packet-file envelope: the change slug."
    },
    "baseSha": {
      "type": "string",
      "minLength": 1,
      "description": "Packet-file envelope: the commit the map was read at."
    },
    "surfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^S[0-9]+$",
            "description": "A surface id in the scope map."
          },
          "key": {
            "type": "string",
            "minLength": 1,
            "description": "The map node key (feature:..., surface:..., action:..., thing:...) when the surface has one."
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "detail": {
            "type": "string"
          },
          "citations": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(R[0-9]+|A[0-9]+|L-(code|product|related|history)-[0-9]+)$"
            },
            "description": "Ids that resolve (SCP-CITE-001): a lens item L-<lens>-<n>, a source ref R<n> in fact:brief.refs, or an answer A<n> in the answer log.",
            "minItems": 1
          },
          "lens": {
            "enum": [
              "code",
              "product",
              "related",
              "history"
            ]
          },
          "graphStatus": {
            "enum": [
              "mapped",
              "new",
              "unmapped",
              "unknown"
            ]
          },
          "trust": {
            "enum": [
              "untrusted",
              "owner"
            ],
            "description": "Stamped by code (SCP-TRUST-001). The spec 7.3 example carries it on a question; a draft-stage model-written value is a finding, so it is optional here."
          }
        },
        "required": [
          "id",
          "kind",
          "title",
          "citations"
        ],
        "additionalProperties": false
      }
    },
    "implications": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "citations": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(R[0-9]+|A[0-9]+|L-(code|product|related|history)-[0-9]+)$"
            },
            "description": "Ids that resolve (SCP-CITE-001): a lens item L-<lens>-<n>, a source ref R<n> in fact:brief.refs, or an answer A<n> in the answer log.",
            "minItems": 1
          },
          "surfaces": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^S[0-9]+$",
              "description": "A surface id in the scope map."
            }
          },
          "trust": {
            "enum": [
              "untrusted",
              "owner"
            ],
            "description": "Stamped by code (SCP-TRUST-001). The spec 7.3 example carries it on a question; a draft-stage model-written value is a finding, so it is optional here."
          }
        },
        "required": [
          "id",
          "text",
          "citations"
        ],
        "additionalProperties": false
      }
    },
    "workstreams": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "surfaces": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^S[0-9]+$",
              "description": "A surface id in the scope map."
            },
            "minItems": 1
          },
          "deps": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "title",
          "surfaces",
          "deps"
        ],
        "additionalProperties": false
      }
    },
    "flagged": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item": {
            "type": "string",
            "minLength": 1,
            "description": "A lens item id or a surface id."
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "item",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "excluded": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item": {
            "type": "string",
            "minLength": 1,
            "description": "A lens item id or a surface id."
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "item",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "unmapped": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string"
          },
          "trust": {
            "enum": [
              "untrusted",
              "owner"
            ],
            "description": "Stamped by code (SCP-TRUST-001). The spec 7.3 example carries it on a question; a draft-stage model-written value is a finding, so it is optional here."
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rule": {
            "type": "string",
            "minLength": 1
          },
          "item": {
            "type": "string"
          },
          "why": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "rule",
          "why"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "surfaces",
    "implications",
    "workstreams",
    "flagged",
    "excluded",
    "unmapped",
    "unresolved"
  ],
  "additionalProperties": false
}
