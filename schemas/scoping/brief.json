{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jthorare/agentic-workflow/schemas/scoping/brief.json",
  "title": "Brief (fact:brief)",
  "description": "Spec section 4: \"fact:brief is { text, refs: [{ id, source, key, version, trust, fetchedAt }], subject }\".",
  "type": "object",
  "properties": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^R[1-9][0-9]*$"
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "key": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "trust": {
            "type": "string"
          },
          "fetchedAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "source",
          "key",
          "version",
          "trust",
          "fetchedAt"
        ],
        "additionalProperties": false
      }
    },
    "subject": {
      "type": "string"
    }
  },
  "required": [
    "text",
    "refs",
    "subject"
  ],
  "additionalProperties": false
}
