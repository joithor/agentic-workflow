{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jthorare/agentic-workflow/schemas/packets/acceptance.schema.json",
  "title": "Packet acceptance file (schemaVersion 1)",
  "type": "object",
  "properties": {
    "$schema": {
      "type": [
        "string",
        "null"
      ]
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "parent": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "\\S"
          },
          "text": {
            "type": "string"
          },
          "status": {
            "enum": [
              "failing",
              "passing",
              "superseded"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "commit": {
                  "type": "string",
                  "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
                },
                "at": true
              },
              "required": [
                "kind",
                "path",
                "sha256",
                "commit",
                "at"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "text",
          "status",
          "evidence"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "parent",
    "items"
  ],
  "additionalProperties": false
}
