{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jthorare/agentic-workflow/schemas/packets/packet.schema.json",
  "title": "Packet packet file (schemaVersion 1)",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "integer"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "repo": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$"
    },
    "baseSha": {
      "type": "string"
    },
    "status": {
      "enum": [
        "draft",
        "frozen"
      ]
    },
    "hash": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "links": {
      "type": "object",
      "properties": {
        "decisions": {
          "type": "string"
        },
        "outOfScope": {
          "type": "string"
        },
        "tasks": {
          "type": "string"
        },
        "design": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "plans": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "workflow": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "decisions",
        "outOfScope",
        "tasks",
        "design",
        "plans"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "repo",
    "baseSha",
    "status",
    "links"
  ]
}
