{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jthorare/agentic-workflow/schemas/packets/pull-request.schema.json",
  "title": "Packet pull-request file (schemaVersion 1)",
  "type": "object",
  "properties": {
    "$schema": {
      "type": [
        "string",
        "null"
      ]
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "base": {
      "type": "string"
    },
    "headBranch": {
      "type": "string"
    },
    "headSha": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "stackParent": {
      "type": [
        "string",
        "null"
      ]
    },
    "title": {
      "type": "string"
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schemaVersion",
    "base",
    "headBranch",
    "headSha",
    "stackParent",
    "title",
    "labels"
  ],
  "additionalProperties": false
}
