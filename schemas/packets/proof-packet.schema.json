{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jthorare/agentic-workflow/schemas/packets/proof-packet.schema.json",
  "title": "Packet proof-packet file (schemaVersion 1)",
  "type": "object",
  "properties": {
    "$schema": {
      "type": [
        "string",
        "null"
      ]
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "proof"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "repo": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]*[A-Za-z0-9_-]/[A-Za-z0-9._-]*[A-Za-z0-9_-]$",
      "description": "owner/name; aw-packets also refuses Windows device names (con, prn, aux, nul, com1-9, lpt1-9) on either side"
    },
    "baseSha": {
      "type": "string"
    },
    "status": {
      "enum": [
        "draft",
        "frozen"
      ]
    },
    "hash": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "links": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "proof": {
          "type": "string"
        },
        "red": {
          "type": "string"
        },
        "beforeAfter": {
          "type": "string"
        },
        "holdout": {
          "type": "string"
        },
        "notProven": {
          "type": "string"
        },
        "acceptance": {
          "type": "string"
        },
        "index": {
          "type": "string"
        },
        "appRun": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "proof",
        "red",
        "beforeAfter",
        "holdout",
        "notProven",
        "acceptance",
        "index",
        "appRun",
        "evidence"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "repo",
    "baseSha",
    "status",
    "links"
  ],
  "additionalProperties": false
}
