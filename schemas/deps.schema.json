{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jthorare/agentic-workflow/schemas/deps.schema.json",
  "title": "deps.yaml — the declared package graph (spec §4b.1a)",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "limits", "packages", "edges", "exceptions"],
  "properties": {
    "version": { "const": 1 },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectFanOut"],
      "properties": {
        "projectFanOut": { "type": "integer", "minimum": 1, "description": "Max in-repo project edges per package (hosts and test packages exempt)." }
      }
    },
    "packages": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/package" } },
    "edges": { "type": "array", "items": { "$ref": "#/$defs/edge" } },
    "exceptions": { "type": "array", "items": { "$ref": "#/$defs/exception" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
    "relPath": { "type": "string", "minLength": 1, "pattern": "^[^/~$][^\\s]*$" },
    "relPaths": { "type": "array", "items": { "$ref": "#/$defs/relPath" }, "uniqueItems": true },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "ts", "src", "note"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["package", "shell", "mod"], "description": "package = ported to C# under src/; shell = bash that stays; mod = Claude Code mod that stays TS." },
        "tier": { "type": "integer", "minimum": 0, "maximum": 3 },
        "sublevel": { "type": "integer", "minimum": 0, "maximum": 9, "description": "Orders packages inside one tier (only the tier-0 kernel family uses it)." },
        "test": { "type": "boolean", "description": "A test-support package: exempt from the fan-out limit." },
        "ts": { "type": ["string", "null"], "description": "Where the TypeScript lives today, or null." },
        "src": { "type": ["string", "null"], "description": "Where the C# package lives after its port, or null for shell and mod nodes." },
        "projectPrefix": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9.]*$", "description": "C# project names that belong to this package start with this prefix." },
        "scan": { "$ref": "#/$defs/relPaths", "description": "Source dirs scanned for cli/db/file edges." },
        "bins": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }, "uniqueItems": true },
        "binPaths": { "$ref": "#/$defs/relPaths", "description": "Repo-relative entry points launched by path (no installed bin)." },
        "db": { "$ref": "#/$defs/relPaths", "description": "SQLite files this package owns, relative to the state root." },
        "files": { "$ref": "#/$defs/relPaths", "description": "State files or dirs this package owns, relative to the state root." },
        "note": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "package" } } }, "then": { "required": ["tier", "projectPrefix"] } }
      ]
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "kind", "status", "note"],
      "properties": {
        "from": { "$ref": "#/$defs/id" },
        "to": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["project", "cli", "db", "file"] },
        "status": { "enum": ["current", "planned"], "description": "current = the scan must find it today; planned = allowed, not yet built." },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule", "subject", "reason", "recorded", "expires"],
      "properties": {
        "rule": { "type": "string", "pattern": "^DEPS-[A-Z]+-[0-9]{3}$" },
        "subject": { "$ref": "#/$defs/id" },
        "reason": { "type": "string", "minLength": 1 },
        "recorded": { "$ref": "#/$defs/date" },
        "expires": { "$ref": "#/$defs/date" }
      }
    }
  }
}
