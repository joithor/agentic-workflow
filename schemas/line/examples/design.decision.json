  "decisions": [
    {
      "id": "D3",
      "question": "Where does link expiry run: on read, or in the nightly job?",
      "affects": [
        "sec-4.2",
        "sec-6"
      ],
      "cites": [
        "S2",
        "AC-4",
        "L-code-7"
      ],
      "options": [
        {
          "id": "D3.a",
          "answer": "Checked on read, in the public route.",
          "tradeoffs": "Exact to the second; one indexed lookup per read.",
          "recommended": true
        },
        {
          "id": "D3.b",
          "answer": "Swept by the nightly job.",
          "tradeoffs": "No read cost; a link lives up to a day too long, which AC-4 forbids."
        }
      ],
      "status": "open"
    }
  ],
