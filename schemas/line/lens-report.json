{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jthorare/agentic-workflow/schemas/line/lens-report.json",
  "title": "One lens's report (fact:lensReport)",
  "description": "Line spec A.3: \"lens id, pack hash, findings with severity, citation and the suggested resolution, and notApplicable with a reason if the lens has nothing to say\". Severity is the pack's scale; CRITICAL, HIGH, MEDIUM and LOW are the levels 4.1 and DSN-LENS-001/003 name.",
  "type": "object",
  "properties": {
    "lens": {
      "type": "string",
      "minLength": 1
    },
    "packHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "CRITICAL",
              "HIGH",
              "MEDIUM",
              "LOW"
            ]
          },
          "citation": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "resolution": {
            "type": "string",
            "minLength": 1
          },
          "escalate": {
            "type": "object",
            "description": "BS-12: a typed escalation (escalation.json's kind, question and options); the only way a finding reaches a human.",
            "properties": {
              "kind": {
                "enum": [
                  "ambiguousFix",
                  "productQuestion"
                ]
              },
              "question": {
                "type": "string",
                "minLength": 1
              },
              "options": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "kind",
              "question"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "severity",
          "citation",
          "text",
          "resolution"
        ],
        "additionalProperties": false
      }
    },
    "notApplicable": {
      "type": "string",
      "minLength": 1,
      "description": "Why the lens has nothing to say."
    }
  },
  "required": [
    "lens",
    "packHash"
  ],
  "additionalProperties": false,
  "not": {
    "required": [
      "findings",
      "notApplicable"
    ],
    "properties": {
      "findings": {
        "minItems": 1
      }
    }
  }
}
