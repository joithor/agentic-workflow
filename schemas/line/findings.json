{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jthorare/agentic-workflow/schemas/line/findings.json",
  "title": "Findings (fact:findings)",
  "description": "Line spec A.5: exec-review objections, \"per phase, the question, the objection and the concrete change\"; A.8: a blocked build, \"the path, why it's needed, the item\". The checks (4.3, 6.3) and lens rounds also write fact:findings, in scoping's findings shape (rule, item, message, fix, severity) and A.3's finding shape, so each entry is any of the four.",
  "type": "array",
  "items": {
    "oneOf": [
      {
        "type": "object",
        "properties": {
          "phase": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "enum": [
              "executable",
              "context",
              "files",
              "signals"
            ],
            "description": "FA 17.23.14's four answers, in A.5's order."
          },
          "objection": {
            "type": "string",
            "minLength": 1
          },
          "change": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "phase",
          "question",
          "objection",
          "change"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "why": {
            "type": "string",
            "minLength": 1
          },
          "item": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "path",
          "why",
          "item"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "rule": {
            "type": "string",
            "minLength": 1
          },
          "item": {
            "type": [
              "string",
              "null"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "fix": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          }
        },
        "required": [
          "rule",
          "message"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "CRITICAL",
              "HIGH",
              "MEDIUM",
              "LOW"
            ]
          },
          "citation": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "resolution": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "severity",
          "citation",
          "text",
          "resolution"
        ],
        "additionalProperties": false
      }
    ]
  }
}
