{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jthorare/agentic-workflow/schemas/line/built.json",
  "title": "The built change (fact:built)",
  "description": "Line spec A.8: \"the head sha and each commit's sha, type and subject\". The type is the conventional-commit type (feat, fix, refactor, test, docs, chore).",
  "type": "object",
  "properties": {
    "head": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,64}$"
    },
    "commits": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{7,64}$"
          },
          "type": {
            "enum": [
              "feat",
              "fix",
              "refactor",
              "test",
              "docs",
              "chore"
            ]
          },
          "subject": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "sha",
          "type",
          "subject"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "head",
    "commits"
  ],
  "additionalProperties": false
}
