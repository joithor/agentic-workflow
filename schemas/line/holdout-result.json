{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jthorare/agentic-workflow/schemas/line/holdout-result.json",
  "title": "The evaluator's verdicts (fact:holdoutResult)",
  "description": "Line spec 9.3: \"per scenario, the verdict, the item id, a category and an observed line\", the observed line at most 200 characters and never the scenario's expected result or steps. A.9: \"record pass or fail\". The category values and the head field are not named in the spec; category is free text and head is optional.",
  "type": "object",
  "properties": {
    "head": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,64}$"
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "item": {
            "type": "string",
            "minLength": 1
          },
          "verdict": {
            "enum": [
              "pass",
              "fail"
            ]
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "observed": {
            "type": "string",
            "maxLength": 200
          }
        },
        "required": [
          "id",
          "item",
          "verdict",
          "category"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "scenarios"
  ],
  "additionalProperties": false
}
