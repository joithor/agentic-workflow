{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jthorare/agentic-workflow/schemas/line/holdout-sets.json",
  "title": "The hidden scenario sets (fact:holdoutSets)",
  "description": "Line spec A.6: \"per phase, scenario ids, item ids, the count and the set hash; no text field exists\" (9.1: packets hold ids, evidence kinds, counts and the set hash only). additionalProperties is false so a scenario text cannot ride along.",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "phase": {
        "type": "string",
        "minLength": 1
      },
      "scenarioIds": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "minItems": 1,
        "uniqueItems": true
      },
      "itemIds": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "minItems": 1
      },
      "count": {
        "type": "integer",
        "minimum": 1
      },
      "setHash": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "required": [
      "phase",
      "scenarioIds",
      "itemIds",
      "count",
      "setHash"
    ],
    "additionalProperties": false
  }
}
