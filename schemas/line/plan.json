{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jthorare/agentic-workflow/schemas/line/plan.json",
  "title": "The plan (fact:plan)",
  "description": "Line spec A.4: \"PKT's task plan\", the TaskPlan record of docs/csharp/packets.md (schemas/packets/tasks.schema.json): workstreams and tasks with deps, size, writeScope, readSeeds, acceptance, rules and budget. L and XL parse here and are refused by PLN-SIZE-001, as the spec has aw-packets and the plan check own the limits.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "workstreams": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title"
        ],
        "additionalProperties": false
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "workstream": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string"
          },
          "deps": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "size": {
            "enum": [
              "XS",
              "S",
              "M",
              "L",
              "XL"
            ]
          },
          "writeScope": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "readSeeds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "acceptance": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "text": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "holdout": {
                  "type": "boolean"
                }
              },
              "required": [
                "id",
                "evidence"
              ],
              "additionalProperties": false
            }
          },
          "rules": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "budget": {
            "type": "object",
            "properties": {
              "tokens": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "turns": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "wallMinutes": {
                "type": [
                  "integer",
                  "null"
                ]
              }
            },
            "required": [],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "workstream",
          "title",
          "deps",
          "size",
          "writeScope",
          "readSeeds",
          "acceptance",
          "budget"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "workstreams",
    "tasks"
  ],
  "additionalProperties": false
}
