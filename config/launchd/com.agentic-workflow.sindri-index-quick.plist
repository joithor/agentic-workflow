<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.agentic-workflow.sindri-index-quick</string>
  <key>ProgramArguments</key>
  <array>
    <string>__BIN__/sindri</string>
    <string>index</string>
    <string>build</string>
    <string>--quick</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__BIN__:__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StartInterval</key>
  <integer>3600</integer>
  <key>StandardOutPath</key>
  <string>__HOME__/.agentic-workflow/sindri/index-quick-launchd.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.agentic-workflow/sindri/index-quick-launchd.log</string>
</dict>
</plist>
