<Project Sdk="Microsoft.NET.Sdk">
  <!-- Aw.Redaction: tier 0, sublevel 0 (deps.yaml), the BCL only (spec §4b.1a, §4e B10). The one secret-pattern set
       the scrubber, the gates and Aw.Kernel.Telemetry's scrubbing processor share (spec §4c "One pattern source").
       It replaces the copies in judge (redact.ts) and sindri (scrub/patterns.ts) when those packages are ported. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Aw.Redaction</RootNamespace>
    <!-- Domain-free and pure: no clock, ids, I/O or environment (BannedSymbols.txt). -->
    <AwBannedSymbols>true</AwBannedSymbols>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Aw.Redaction.Tests" />
  </ItemGroup>
</Project>
