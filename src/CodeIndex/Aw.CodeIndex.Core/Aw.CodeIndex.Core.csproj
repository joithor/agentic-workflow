<Project Sdk="Microsoft.NET.Sdk">
  <!-- Aw.CodeIndex.Core (scaffolded by /new-package): domain types, typed ids, value objects, pure logic, port
       interfaces and errors. No I/O, clock or random ids (BannedSymbols.txt, spec §4b.1). code index: symbols, callers and callees per repo, built in the background when trunk moves (code-index spec) -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Aw.CodeIndex.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Vogen" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../Aw.Kernel/Aw.Kernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Aw.CodeIndex.Tests" />
    <InternalsVisibleTo Include="Aw.CodeIndex.Testing" />
  </ItemGroup>
</Project>
