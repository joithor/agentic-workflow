<Project Sdk="Microsoft.NET.Sdk">
  <!-- Aw.CodeIndex.Infrastructure (scaffolded by /new-package): the adapters behind Core's ports (SQL repositories,
       processes, HTTP, files) and this package's settings, read from the environment Composition passes (spec §4b.1,
       .agents/rules/csharp.md Seams). Its row and DTO types stay internal (ARCH-INFRA-001). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Aw.CodeIndex.Infrastructure</RootNamespace>
    <!-- AwAotCompatible=false: the C# parser (CI-4) uses Roslyn's Microsoft.CodeAnalysis.CSharp, which is not trim or
         NativeAOT safe. Nothing that references this project is published NativeAOT: the Sindri host is
         framework-dependent. -->
    <AwAotCompatible>false</AwAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <!-- Roslyn (CI-4): the parser reads C# with the central Microsoft.CodeAnalysis.CSharp pin (5.9.0, the newest published Roslyn).
         Nothing else in this project references Roslyn. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Aw.CodeIndex.Core/Aw.CodeIndex.Core.csproj" />
    <ProjectReference Include="../../Aw.Kernel/Aw.Kernel.csproj" />
    <ProjectReference Include="../../Aw.Kernel.Data/Aw.Kernel.Data.csproj" />
    <ProjectReference Include="../../Redaction/Aw.Redaction/Aw.Redaction.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Aw.CodeIndex.Tests" />
    <InternalsVisibleTo Include="Aw.CodeIndex.Testing" />
  </ItemGroup>
</Project>
