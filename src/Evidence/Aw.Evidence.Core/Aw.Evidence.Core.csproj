<Project Sdk="Microsoft.NET.Sdk">
  <!-- Aw.Evidence.Core (scaffolded by /new-package): domain types, typed ids, value objects, pure logic, port
       interfaces and errors. No I/O, clock or random ids (BannedSymbols.txt, spec §4b.1). Playwright UI evidence; owns the box-wide heavy-job and QA-stack locks today (config/lib/locks.sh primitive). A tier-0 or tier-1 package can't take those locks (that would be an upward file edge, DEPS-TIER-002), so the locks move to the Kernel Lease port before one needs them -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Aw.Evidence.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Vogen" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../Aw.Kernel/Aw.Kernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Aw.Evidence.Tests" />
    <InternalsVisibleTo Include="Aw.Evidence.Testing" />
  </ItemGroup>
</Project>
