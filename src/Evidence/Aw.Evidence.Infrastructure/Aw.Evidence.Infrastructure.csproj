<Project Sdk="Microsoft.NET.Sdk">
  <!-- Aw.Evidence.Infrastructure (scaffolded by /new-package): the adapters behind Core's ports (SQL repositories,
       processes, HTTP, files) and this package's settings, read from the environment Composition passes (spec §4b.1,
       .agents/rules/csharp.md Seams). Its row and DTO types stay internal (ARCH-INFRA-001). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Aw.Evidence.Infrastructure</RootNamespace>
    <!-- DirectoryLocks calls the C library's mkdir through [LibraryImport], whose generated marshalling is unsafe code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Aw.Evidence.Core/Aw.Evidence.Core.csproj" />
    <ProjectReference Include="../../Aw.Kernel/Aw.Kernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Aw.Evidence.Tests" />
    <InternalsVisibleTo Include="Aw.Evidence.Testing" />
  </ItemGroup>
</Project>
