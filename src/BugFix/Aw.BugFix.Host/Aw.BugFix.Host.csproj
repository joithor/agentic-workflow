<Project Sdk="Microsoft.NET.Sdk">
  <!-- Aw.BugFix.Host (scaffolded by /new-package): the composition root and the CLI commands
       (one per slice). NativeAOT entry point 'bugfix-state' (spec §4b.6); the only project that uses Infrastructure, in
       Composition. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AwAotEntryPoint>true</AwAotEntryPoint>
    <PublishAot Condition="'$(RuntimeIdentifier)' != ''">true</PublishAot>
    <AssemblyName>bugfix-state</AssemblyName>
    <RootNamespace>Aw.BugFix.Host</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Aw.BugFix.Core/Aw.BugFix.Core.csproj" />
    <ProjectReference Include="../Aw.BugFix.Features/Aw.BugFix.Features.csproj" />
    <ProjectReference Include="../Aw.BugFix.Infrastructure/Aw.BugFix.Infrastructure.csproj" />
    <ProjectReference Include="../../Aw.Kernel/Aw.Kernel.csproj" />
    <ProjectReference Include="../../Aw.Kernel.Telemetry/Aw.Kernel.Telemetry.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Aw.BugFix.Tests" />
  </ItemGroup>
</Project>
