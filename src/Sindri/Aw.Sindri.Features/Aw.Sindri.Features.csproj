<Project Sdk="Microsoft.NET.Sdk">
  <!-- Aw.Sindri.Features (scaffolded by /new-package): one folder per use case (slice): request and response
       records, the service and its validator (spec §4b.2). Another package only through its Core. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Aw.Sindri.Features</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <!-- ILogger and [LoggerMessage] for the command chain's audit trail (SND-LEDGER-002 when an accepted command's audit row is lost). -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Aw.Sindri.Core/Aw.Sindri.Core.csproj" />
    <ProjectReference Include="../../Context/Aw.Context.Core/Aw.Context.Core.csproj" />
    <ProjectReference Include="../../CodeIndex/Aw.CodeIndex.Core/Aw.CodeIndex.Core.csproj" />
    <ProjectReference Include="../../Aw.Kernel/Aw.Kernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The scoping station's fact schemas (SC-K): the draft check validates a model's facts against their $defs/fact directly. -->
    <ScopingSchema Include="../../../schemas/scoping/*.json" />
    <EmbeddedResource Include="@(ScopingSchema)" LogicalName="scoping-schemas/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Aw.Sindri.Tests" />
    <InternalsVisibleTo Include="Aw.Sindri.Engine.Tests" />
    <InternalsVisibleTo Include="Aw.Sindri.Testing" />
    <InternalsVisibleTo Include="sindri" />
  </ItemGroup>
  <!-- An empty glob embeds nothing and the scoping Steps throw at run time (a publish copy tree without schemas/scoping did): make it a build error. -->
  <Target Name="RequireScopingSchemas" BeforeTargets="PrepareForBuild">
    <Error Condition="'@(ScopingSchema)' == ''" Text="No scoping schema to embed: ../../../schemas/scoping/*.json matched nothing. A publish copy tree must carry schemas/scoping (scripts/lib/sindri-build-inputs.sh)." />
  </Target>
</Project>
