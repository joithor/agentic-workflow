<Project Sdk="Microsoft.NET.Sdk">
  <!-- Aw.Sindri.Ui.Capture: the Sindri app's screens, rendered headless (Avalonia.Headless with Skia) against the running control plane
       and saved as PNGs, for desktop UI evidence (docs/csharp/evidence.md "desktop-run"). A second head of Aw.Sindri.Ui beside
       Aw.Sindri.Ui.Desktop: it composes the same shell and the same typed API client, reads the same endpoint record and human token,
       and holds no views or logic of its own. A run tool, not the app: it is run with `dotnet run` or published beside the app, never
       NativeAOT (headless drawing is not trimmed for it, and the app's own AOT publish stays free of it). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>sindri-ui-capture</AssemblyName>
    <RootNamespace>Aw.Sindri.Ui.Capture</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AwAotCompatible>false</AwAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Aw.Sindri.Ui/Aw.Sindri.Ui.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Aw.Sindri.Ui.Rendering.Tests" />
  </ItemGroup>
</Project>
