<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:facts="using:Aw.Sindri.Ui.ViewModels.Facts"
             x:Class="Aw.Sindri.Ui.Views.Facts.FileFactView"
             x:DataType="facts:FileFactViewer">
  <!-- A file fact: its name, size and hash as served, and Open. When the platform can't open the path, a note says where it is. -->
  <StackPanel Spacing="4">
    <WrapPanel Orientation="Horizontal">
      <TextBlock x:Name="FactFileName" Classes="body-strong" Text="{Binding Name}" Margin="0,0,12,0" AutomationProperties.Name="{Binding Name}" />
      <TextBlock x:Name="FactFileSize" Classes="caption mono" Text="{Binding SizeText}" Margin="0,0,12,0" />
      <TextBlock x:Name="FactFileHash" Classes="caption mono subtle" Text="{Binding HashText}" />
    </WrapPanel>
    <TextBlock x:Name="FactFilePath" Classes="caption mono subtle" Text="{Binding Path}" TextWrapping="Wrap" />
    <Button x:Name="FactFileOpen" Content="Open" HorizontalAlignment="Left" IsVisible="{Binding CanOpen}" Click="OnOpen" AutomationProperties.Name="{Binding OpenName}" />
    <TextBlock x:Name="FactFileNote" Classes="caption" Text="{Binding OpenNote}" IsVisible="{Binding HasOpenNote}" TextWrapping="Wrap" AutomationProperties.Name="{Binding OpenNote}" />
  </StackPanel>
</UserControl>
