<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:facts="using:Aw.Sindri.Ui.ViewModels.Facts"
             x:Class="Aw.Sindri.Ui.Views.Facts.ScopeMapFactView"
             x:DataType="facts:ScopeMapViewer">
  <!-- A scope-map fact: a counts line, a row per surface (title, meta, graph chip, count), short sections, and Show raw for the payload tree. A body with no surfaces shows the tree. -->
  <StackPanel Spacing="6">
    <TextBlock x:Name="ScopeLoading" Classes="caption muted" Text="{Binding LoadingText}" IsVisible="{Binding IsLoading}" />
    <TextBlock x:Name="ScopeAnnouncement" Classes="caption live-region" Classes.live="{Binding Voice.IsAnnouncing}" Width="0" Opacity="0" IsHitTestVisible="False" Text="{Binding Voice.Announcement}" />
    <TextBlock x:Name="ScopeProblem" Classes="body" Text="{Binding ProblemText}" IsVisible="{Binding HasProblem}" TextWrapping="Wrap" AutomationProperties.Name="{Binding ProblemText}" />
    <StackPanel x:Name="ScopeTable" Spacing="6" IsVisible="{Binding ShowsTable}" AutomationProperties.Name="{Binding TableName}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Group">
      <Border x:Name="ScopeCountsName" HorizontalAlignment="Left" AutomationProperties.Name="{Binding Counts}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
        <TextBlock x:Name="ScopeCounts" Classes="body-strong" Text="{Binding Counts}" AutomationProperties.AccessibilityView="Raw" />
      </Border>
      <ItemsControl x:Name="ScopeSurfaces" ItemsSource="{Binding Surfaces}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="facts:ScopeSurfaceRow">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,6" ColumnSpacing="12">
              <Border Name="ScopeChipName" Grid.Column="0" MinWidth="96" VerticalAlignment="Top" IsVisible="{Binding HasChip}"
                      AutomationProperties.Name="{Binding Chip}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
                <TextBlock Name="ScopeChip" Classes="caption mono" Text="{Binding Chip}" AutomationProperties.AccessibilityView="Raw" />
              </Border>
              <StackPanel Grid.Column="1">
                <Border Name="ScopeTitleName" HorizontalAlignment="Left" AutomationProperties.Name="{Binding Title}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
                  <TextBlock Name="ScopeTitle" Classes="body-strong" Text="{Binding Title}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
                </Border>
                <Border Name="ScopeMetaName" HorizontalAlignment="Left" IsVisible="{Binding HasMeta}" AutomationProperties.Name="{Binding Meta}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
                  <TextBlock Name="ScopeMeta" Classes="caption mono subtle" Text="{Binding Meta}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
                </Border>
                <Border Name="ScopeDetailName" HorizontalAlignment="Left" IsVisible="{Binding HasDetail}" AutomationProperties.Name="{Binding Detail}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
                  <TextBlock Name="ScopeDetail" Classes="caption" Text="{Binding Detail}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
                </Border>
              </StackPanel>
              <Border Name="ScopeCountName" Grid.Column="2" VerticalAlignment="Top" IsVisible="{Binding HasCount}" AutomationProperties.Name="{Binding Count}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
                <TextBlock Name="ScopeCount" Classes="caption mono" Text="{Binding Count}" AutomationProperties.AccessibilityView="Raw" />
              </Border>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <ItemsControl x:Name="ScopeSections" ItemsSource="{Binding Sections}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="facts:ScopeSection">
            <StackPanel Margin="0,4,0,4">
              <Border Name="ScopeHeadingName" HorizontalAlignment="Left" AutomationProperties.Name="{Binding Heading}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
                <TextBlock Name="ScopeHeading" Classes="caption subtle" Text="{Binding Heading}" AutomationProperties.AccessibilityView="Raw" />
              </Border>
              <ItemsControl ItemsSource="{Binding Lines}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <Border Name="ScopeLineName" HorizontalAlignment="Left" AutomationProperties.Name="{Binding}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
                      <TextBlock Name="ScopeLine" Classes="caption" Text="{Binding}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
    <TreeView x:Name="ScopeTree" ItemsSource="{Binding Tree}" MaxHeight="280" IsVisible="{Binding ShowsTree}" AutomationProperties.Name="{Binding Row.Label}">
      <TreeView.ItemTemplate>
        <TreeDataTemplate x:DataType="facts:PayloadNodeViewModel" ItemsSource="{Binding Children}">
          <TextBlock Classes="caption mono" Text="{Binding Text}" TextWrapping="Wrap" />
        </TreeDataTemplate>
      </TreeView.ItemTemplate>
    </TreeView>
    <Button x:Name="ScopeToggle" Content="{Binding ToggleLabel}" HorizontalAlignment="Left" IsVisible="{Binding HasSurfaces}" Click="OnToggle" AutomationProperties.Name="{Binding ToggleLabel}" />
    <TextBlock x:Name="ScopeTruncated" Classes="caption" Text="{Binding TruncatedNote}" IsVisible="{Binding HasTruncatedNote}" TextWrapping="Wrap" AutomationProperties.Name="{Binding TruncatedNote}" />
  </StackPanel>
</UserControl>
