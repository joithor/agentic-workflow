<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:facts="using:Aw.Sindri.Ui.ViewModels.Facts"
             x:Class="Aw.Sindri.Ui.Views.Facts.ItemFactView"
             x:DataType="facts:ItemFactViewer">
  <!-- An item fact: the item's id and what the engine said of it, and Open, which opens the item's sheet in the same sheet. -->
  <WrapPanel Orientation="Horizontal">
    <TextBlock x:Name="FactItemId" Classes="body-strong mono" Text="{Binding ItemId}" VerticalAlignment="Center" Margin="0,0,12,0" AutomationProperties.Name="{Binding ItemId}" />
    <TextBlock x:Name="FactItemDetail" Classes="body" Text="{Binding Detail}" VerticalAlignment="Center" Margin="0,0,12,0" />
    <Button x:Name="FactItemOpen" Content="Open" IsVisible="{Binding CanOpen}" Click="OnOpen" AutomationProperties.Name="{Binding OpenName}" />
  </WrapPanel>
</UserControl>
