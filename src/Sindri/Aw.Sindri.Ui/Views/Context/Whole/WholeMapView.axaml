<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aw.Sindri.Ui.ViewModels.Context.Whole"
             xmlns:ctl="using:Aw.Sindri.Ui.Views.Controls"
             xmlns:icons="using:Aw.Sindri.Ui.Views.Icons"
             xmlns:wv="using:Aw.Sindri.Ui.Views.Context.Whole"
             x:Class="Aw.Sindri.Ui.Views.Context.Whole.WholeMapView"
             x:DataType="vm:WholeMapViewModel"
             ClipToBounds="True">
  <!-- The whole map (whole-map spec §3): the size line and, when the map is grouped by feature, why; the list of features (also the
       accessible map: Tab walks it, Enter opens); the pannable canvas with the mini-map and the zoom pill over it. -->
  <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
    <StackPanel Spacing="2">
      <Button x:Name="WholeAllFeatures" Content="{Binding AllFeaturesText}" IsVisible="{Binding IsAreaOpen}" Click="OnAllFeatures" HorizontalAlignment="Left" AutomationProperties.Name="{Binding AllFeaturesText}" />
      <TextBlock x:Name="WholeAreaTitle" Classes="body-strong" Text="{Binding AreaTitle}" IsVisible="{Binding IsAreaOpen}" AutomationProperties.Name="{Binding AreaTitle}" />
      <TextBlock x:Name="WholeSize" Classes="caption subtle" Text="{Binding SizeText}" AutomationProperties.Name="{Binding SizeText}" />
      <TextBlock x:Name="WholeNote" Classes="body" Text="{Binding ByAreaNote}" IsVisible="{Binding HasNote}" TextWrapping="Wrap" AutomationProperties.Name="{Binding ByAreaNote}" />
    </StackPanel>

    <!-- One line, always: the chips that fit, then "+N more" (a popover with the rest), so the graph under the row is never pushed out of the stage. -->
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="6">
      <ItemsControl x:Name="WholeAreas" ItemsSource="{Binding Chips}" AutomationProperties.Name="{Binding AreasName}" ClipToBounds="True">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><ctl:OneLinePanel /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:WholeAreaTileViewModel">
            <Button Classes="area-chip" Click="OnAreaChip" Padding="8,2" AutomationProperties.Name="{Binding Name}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Border Width="10" Height="10" CornerRadius="5" VerticalAlignment="Center" Background="{Binding Colour, Converter={x:Static wv:AreaBrush.Instance}}" />
                <TextBlock Classes="caption" Text="{Binding Label}" AutomationProperties.AccessibilityView="Raw" />
                <TextBlock Classes="caption subtle" Text="{Binding MembersText}" AutomationProperties.AccessibilityView="Raw" />
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Button x:Name="WholeMoreChips" Grid.Column="1" Classes="area-chip" Padding="8,2" IsVisible="False" Click="OnMoreChips" />
      <Popup x:Name="WholeMoreChipsPopup" PlacementTarget="{Binding #WholeMoreChips}" Placement="BottomEdgeAlignedRight" IsLightDismissEnabled="True">
        <Border Background="{DynamicResource Brush.Surface1}" BorderBrush="{DynamicResource Brush.Hairline}" BorderThickness="1" CornerRadius="{StaticResource Radius.SM}" Padding="8" Width="380">
          <ScrollViewer MaxHeight="280" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" IsTabStop="False">
            <ItemsControl x:Name="WholeHiddenChips" AutomationProperties.Name="{Binding AreasName}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:WholeAreaTileViewModel">
                  <Button Classes="area-chip" Click="OnAreaChip" Margin="0,0,6,6" Padding="8,2" AutomationProperties.Name="{Binding Name}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Border Width="10" Height="10" CornerRadius="5" VerticalAlignment="Center" Background="{Binding Colour, Converter={x:Static wv:AreaBrush.Instance}}" />
                      <TextBlock Classes="caption" Text="{Binding Label}" AutomationProperties.AccessibilityView="Raw" />
                      <TextBlock Classes="caption subtle" Text="{Binding MembersText}" AutomationProperties.AccessibilityView="Raw" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
      </Popup>
    </Grid>

    <Grid Grid.Row="2">
      <ctl:ZoomBorder x:Name="WholeCanvas" AutomationProperties.Name="{Binding CanvasName}">
        <wv:WholeMapCanvas x:Name="WholeWorld" />
      </ctl:ZoomBorder>

      <!-- The card (F3 context spec): nothing is chosen until a query zooms in. -->
      <Border x:Name="WholeCard" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14" Padding="12,10" MaxWidth="320"
              Background="{DynamicResource Brush.Surface1}" BorderBrush="{DynamicResource Brush.Hairline}" BorderThickness="1" CornerRadius="{StaticResource Radius.LG}">
        <StackPanel Spacing="2">
          <TextBlock x:Name="WholeCardTitle" Classes="body-strong" Text="{Binding CardTitle}" AutomationProperties.Name="{Binding CardTitle}" />
          <TextBlock x:Name="WholeCardText" Classes="caption subtle" Text="{Binding CardText}" TextWrapping="Wrap" AutomationProperties.Name="{Binding CardText}" />
          <TextBlock x:Name="WholeMoreTouched" Classes="caption" Text="{Binding MoreTouchedText}" IsVisible="{Binding HasMoreTouched}" AutomationProperties.Name="{Binding MoreTouchedText}" />
        </StackPanel>
      </Border>

      <Border x:Name="WholeMiniMapHost" Focusable="True" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="14" Width="180" Height="112"
              Background="{DynamicResource Brush.Surface1}" BorderBrush="{DynamicResource Brush.Hairline}" BorderThickness="1" CornerRadius="{StaticResource Radius.SM}"
              KeyDown="OnMiniMapKey" AutomationProperties.Name="Mini-map: arrow keys move the view">
        <ctl:MiniMapControl x:Name="WholeMiniMap" />
      </Border>

      <Border x:Name="WholeZoom" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,14" Height="28"
              Background="{DynamicResource Brush.Surface3}" CornerRadius="{StaticResource Radius.SM}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0">
          <Button x:Name="WholeZoomOut" Click="OnZoomOut" Padding="6,4" Background="Transparent" BorderThickness="0"><icons:StateIcon Icon="Kind.Minus" Foreground="{DynamicResource Brush.InkMuted}" /></Button>
          <TextBlock x:Name="WholeZoomValue" Classes="caption" MinWidth="40" TextAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Ink}" />
          <Button x:Name="WholeZoomIn" Click="OnZoomIn" Padding="6,4" Background="Transparent" BorderThickness="0"><icons:StateIcon Icon="Kind.Plus" Foreground="{DynamicResource Brush.InkMuted}" /></Button>
          <Button x:Name="WholeZoomFit" Click="OnZoomFit" Padding="6,4" Background="Transparent" BorderThickness="0"><icons:StateIcon Icon="Kind.Fit" Foreground="{DynamicResource Brush.InkMuted}" /></Button>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
