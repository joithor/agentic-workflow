<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rec="using:Aw.Sindri.Ui.ViewModels.Recipes"
             x:Class="Aw.Sindri.Ui.Views.Recipes.RecipeStatesBand"
             x:DataType="rec:RecipeStatesViewModel">
  <!-- The recipe's states in the order the API serves them (screens spec §4.3). Each item is a state with the link that follows it, so a wrap never
       starts a line with a link; a branch sits under its source; a loop that does not join neighbours is a note, an output sits under its state.
       No terminal, desk or child mark: the recipe does not serve them. A glyph is never the only sign (the name carries the words). -->
  <Border x:Name="RecipeBand" Classes="frame-panel">
    <StackPanel Spacing="8">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <TextBlock Classes="eyebrow" Text="{Binding Heading}" />
        <TextBlock x:Name="RecipeOrderNote" Classes="caption subtle" Text="{Binding OrderNote}" IsVisible="{Binding HasOrderNote}"
                   AutomationProperties.Name="{Binding OrderNote}" />
      </StackPanel>
      <ItemsControl x:Name="RecipeStateNodes" ItemsSource="{Binding Nodes}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="rec:RecipeStateNodeViewModel">
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,6,6">
              <StackPanel Spacing="2">
                <Border AutomationProperties.Name="{Binding Name}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
                  <StackPanel Spacing="2" AutomationProperties.AccessibilityView="Raw">
                    <TextBlock Name="RecipeStateText" Classes="caption mono" Text="{Binding State}" AutomationProperties.AccessibilityView="Raw" />
                    <ItemsControl ItemsSource="{Binding Notes}" IsVisible="{Binding HasNotes}" AutomationProperties.AccessibilityView="Raw">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                          <TextBlock Name="RecipeStateNote" Classes="caption subtle" Text="{Binding}" TextWrapping="Wrap" MaxWidth="260" AutomationProperties.AccessibilityView="Raw" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding Outputs}" IsVisible="{Binding HasOutputs}" AutomationProperties.AccessibilityView="Raw">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                          <TextBlock Name="RecipeStateOutput" Classes="caption" Text="{Binding}" TextWrapping="Wrap" MaxWidth="260" AutomationProperties.AccessibilityView="Raw" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
                <ItemsControl ItemsSource="{Binding Branches}" IsVisible="{Binding HasBranches}" Margin="12,0,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="rec:RecipeStateNodeViewModel">
                      <Border AutomationProperties.Name="{Binding Name}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
                        <TextBlock Name="RecipeStateText" Classes="caption mono" Text="{Binding State}" AutomationProperties.AccessibilityView="Raw" />
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
              <TextBlock Name="RecipeStateLink" Classes="caption mono subtle" Text="{Binding Link}" VerticalAlignment="Top" AutomationProperties.AccessibilityView="Raw" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </Border>
</UserControl>
