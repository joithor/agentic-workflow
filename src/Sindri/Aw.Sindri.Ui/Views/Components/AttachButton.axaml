<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:att="using:Aw.Sindri.Ui.ViewModels.Components"
             xmlns:views="using:Aw.Sindri.Ui.Views.Components"
             x:Class="Aw.Sindri.Ui.Views.Components.AttachButton"
             x:DataType="att:AttachControlViewModel">
  <UserControl.Styles>
    <!-- The confirm's live region is live only while the confirm shows, so its resting text, set once the gate is off, is
         never spoken (docs/csharp/sindri-ui.md "LiveSetting on macOS"). -->
    <Style Selector="TextBlock.live-region.live">
      <Setter Property="AutomationProperties.LiveSetting" Value="Polite" />
    </Style>
    <!-- The one template's two sizes: the compact size (row actions) trims the buttons' padding; nothing else differs. -->
    <Style Selector="views|AttachButton.compact Button">
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="MinHeight" Value="24" />
    </Style>
  </UserControl.Styles>
  <!-- The Attach component (screens spec §4.5, rev 8 critique run 5 "Attach has four shapes"): the main action, the
       chevron with the rest (Take over, File a request, Cancel), the note under a live Attach, and the Cancel's one-line
       confirm. While Attach is pending (API P10a) a dashed chip stands where the button would be. -->
  <StackPanel Spacing="4">
    <StackPanel Orientation="Horizontal" Spacing="4">
      <Button x:Name="AttachPrimary" Classes="accent" IsVisible="{Binding IsPrimaryShown}" Click="OnPrimary"
              Content="{Binding PrimaryLabel}" AutomationProperties.Name="{Binding PrimaryName}" />
      <Panel x:Name="PendingChip" IsVisible="{Binding IsPending}" AutomationProperties.Name="{Binding PendingChip}">
        <Rectangle Stroke="{DynamicResource Brush.HairlineStrong}" StrokeThickness="1" StrokeDashArray="3,3"
                   RadiusX="4" RadiusY="4" IsHitTestVisible="False" />
        <TextBlock Classes="caption subtle" Margin="10,4" VerticalAlignment="Center" Text="{Binding PendingChip}"
                   AutomationProperties.Name="{Binding PendingChip}" />
      </Panel>
      <Button x:Name="AttachChevron" Content="▾" AutomationProperties.Name="{Binding ChevronName}">
        <Button.Flyout>
          <MenuFlyout Placement="BottomEdgeAlignedLeft" />
        </Button.Flyout>
      </Button>
    </StackPanel>
    <TextBlock x:Name="AttachNote" Classes="caption subtle" TextWrapping="Wrap" IsVisible="{Binding HasNote}"
               Text="{Binding Note}" AutomationProperties.Name="{Binding Note}" />
    <StackPanel x:Name="ConfirmRow" Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsConfirmingCancel}">
      <TextBlock x:Name="ConfirmLine" Classes="body" VerticalAlignment="Center" TextWrapping="Wrap"
                 Text="{Binding ConfirmLine}" AutomationProperties.Name="{Binding ConfirmLine}" />
      <Button x:Name="ConfirmButton" Content="Cancel it" Click="OnConfirm" AutomationProperties.Name="{Binding ConfirmButtonName}" />
      <Button x:Name="KeepButton" Content="Keep" Click="OnKeep" AutomationProperties.Name="{Binding KeepButtonName}" />
    </StackPanel>
    <!-- The confirm's announcement: a polite live region, in the tree from the start so assistive tech has read it before
         its text changes, live only while the confirm shows, and never "" (Avalonia #22312). Zero-width and invisible. -->
    <TextBlock x:Name="ConfirmAnnouncementRegion" Classes="caption live-region" Classes.live="{Binding IsConfirmLive}"
               Width="0" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Left"
               Text="{Binding ConfirmAnnouncement}" />
  </StackPanel>
</UserControl>
