<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ag="using:Aw.Sindri.Ui.ViewModels.Agents"
             xmlns:agv="using:Aw.Sindri.Ui.Views.Agents"
             x:Class="Aw.Sindri.Ui.Views.Agents.SessionGroup"
             x:DataType="ag:SessionGroupViewModel">
  <!-- One group of sessions ("Outside a workflow", "Started by Sindri"): a header with the count that collapses the rows, then the rows. -->
  <StackPanel>
    <Button x:Name="AgentGroupToggle" Classes="group-toggle" Click="OnToggle" AutomationProperties.Name="{Binding ToggleName}">
      <TextBlock Classes="body-strong" Text="{Binding Header}" AutomationProperties.AccessibilityView="Raw" />
    </Button>
    <ItemsControl x:Name="AgentGroupRows" ItemsSource="{Binding Rows}" IsVisible="{Binding IsExpanded}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="ag:SessionRowViewModel">
          <agv:SessionRow />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
