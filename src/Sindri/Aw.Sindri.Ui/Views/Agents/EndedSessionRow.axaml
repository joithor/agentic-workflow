<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ag="using:Aw.Sindri.Ui.ViewModels.Agents"
             x:Class="Aw.Sindri.Ui.Views.Agents.EndedSessionRow"
             x:DataType="ag:EndedSessionViewModel">
  <!-- One session that ended recently: what it was, when, and the command that resumes it, with Copy. -->
  <Border x:Name="EndedRowFrame" Classes="item-row session-row" Classes.selected="{Binding IsSelected}" Focusable="True"
          AutomationProperties.Name="{Binding Name}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="ListItem">
    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Top">
      <StackPanel Spacing="2">
        <TextBlock Classes="body-strong" Text="{Binding TitleText}" TextTrimming="CharacterEllipsis" AutomationProperties.AccessibilityView="Raw" />
        <TextBlock Classes="caption subtle" Text="{Binding EndedText}" AutomationProperties.AccessibilityView="Raw" />
        <TextBlock Classes="caption mono" Text="{Binding ResumeText}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
      </StackPanel>
      <Button x:Name="EndedCopy" Grid.Column="1" Classes="copy" Click="OnCopy" IsEnabled="{Binding CanCopy}" VerticalAlignment="Center" AutomationProperties.Name="{Binding CopyName}">
        <TextBlock Classes="caption" Text="{Binding CopyLabel}" />
      </Button>
    </Grid>
  </Border>
</UserControl>
