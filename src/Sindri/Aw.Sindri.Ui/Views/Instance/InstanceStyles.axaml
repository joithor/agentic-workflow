<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- The instance frame (screens spec §4.2): the band and the expanded state sit on panels; a pending chip is a dashed-feeling quiet outline
       (never a live-looking button); a note under the header is quiet text. Tokens only. -->
  <Style Selector="Border.frame-panel">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface1}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Hairline}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.LG}" />
    <Setter Property="Padding" Value="16,12" />
  </Style>
  <Style Selector="Border.pending-chip">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.HairlineStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.SM}" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.confirm">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.HairlineStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.SM}" />
    <Setter Property="Padding" Value="12,8" />
  </Style>
</Styles>
