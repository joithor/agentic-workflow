<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:inst="using:Aw.Sindri.Ui.ViewModels.Instance"
             xmlns:iv="using:Aw.Sindri.Ui.Views.Instance"
             x:Class="Aw.Sindri.Ui.Views.Instance.ChildrenPanel"
             x:DataType="inst:ChildrenPanelViewModel">
  <!-- The child instances (screens spec §4.2): a group per state that spawned them, a subgroup per workstream when the packet has them, and
       "… N more" with a link that lists all of them in Work when the group lists only some. The headings are served words. -->
  <Border x:Name="ChildrenBlock" Classes="frame-panel" AutomationProperties.Name="{Binding Name}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Group">
    <Expander x:Name="ChildrenDisclosure" Header="{Binding Heading}" IsExpanded="{Binding IsOpen, Mode=TwoWay}">
    <StackPanel Spacing="8">
      <TextBlock x:Name="ChildrenEmpty" Classes="body muted" Text="{Binding EmptyText}" IsVisible="{Binding !HasGroups}" />
      <ItemsControl x:Name="ChildGroups" ItemsSource="{Binding Groups}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="inst:ChildGroupViewModel">
            <StackPanel Spacing="6" Margin="0,0,0,8">
              <WrapPanel Orientation="Horizontal">
                <TextBlock Name="ChildGroupHeader" Classes="body-strong" Text="{Binding Header}" Margin="0,0,12,0" AutomationProperties.Name="{Binding Header}" />
                <TextBlock Name="ChildGroupCounts" Classes="caption mono subtle" Text="{Binding Counts}" VerticalAlignment="Center" />
              </WrapPanel>
              <ItemsControl Name="ChildStreams" ItemsSource="{Binding Streams}" IsVisible="{Binding HasStreams}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="inst:ChildStreamViewModel">
                    <StackPanel Spacing="4" Margin="0,0,0,6">
                      <TextBlock Name="ChildStreamTitle" Classes="caption subtle" Text="{Binding Title}" AutomationProperties.Name="{Binding Title}" />
                      <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="inst:ChildRowViewModel">
                            <iv:ChildRowView />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl Name="ChildPlainRows" ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="inst:ChildRowViewModel">
                    <iv:ChildRowView />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasMore}">
                <TextBlock Name="ChildMore" Classes="caption" Text="{Binding MoreText}" VerticalAlignment="Center" />
                <Button Name="ChildOpenAll" Grid.Column="1" Content="{Binding OpenAllText}" Click="OnOpenAll" AutomationProperties.Name="{Binding OpenAllName}" />
              </Grid>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
    </Expander>
  </Border>
</UserControl>
