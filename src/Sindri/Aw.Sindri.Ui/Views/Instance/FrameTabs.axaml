<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:inst="using:Aw.Sindri.Ui.ViewModels.Instance"
             x:Class="Aw.Sindri.Ui.Views.Instance.FrameTabs"
             x:DataType="inst:FrameTabsViewModel">
  <!-- The frame's tab strip (screens spec §4.2): Timeline, Decisions, Requests and Context with the counts the instance serves. Their content arrives
       with later phases, so each tab is its count and the phase that brings it: plain text, not a control that does nothing. -->
  <ItemsControl x:Name="FrameTabsList" ItemsSource="{Binding Tabs}" AutomationProperties.Name="{Binding Name}" AutomationProperties.AccessibilityView="Control"
                AutomationProperties.ControlTypeOverride="Group">
    <ItemsControl.ItemsPanel>
      <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
    </ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate>
      <DataTemplate x:DataType="inst:FrameTabViewModel">
        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,20,0" AutomationProperties.Name="{Binding Name}" AutomationProperties.AccessibilityView="Control"
                    AutomationProperties.ControlTypeOverride="Text">
          <TextBlock Name="FrameTabText" Classes="body-strong" Text="{Binding Text}" AutomationProperties.AccessibilityView="Raw" />
          <TextBlock Name="FrameTabPhase" Classes="caption subtle" Text="{Binding Phase}" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
        </StackPanel>
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>
</UserControl>
