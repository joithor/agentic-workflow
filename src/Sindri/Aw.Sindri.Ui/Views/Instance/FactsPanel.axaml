<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:facts="using:Aw.Sindri.Ui.ViewModels.Facts"
             x:Class="Aw.Sindri.Ui.Views.Instance.FactsPanel"
             x:DataType="facts:FactsPanelViewModel">
  <!-- The facts the recipe declares, in the order served (screens spec §4.2): the mark and its words, the label and key, the summary as served,
       who and when, the progress, where it came from. View opens the fact's viewer under its row and keeps focus on its own button. A pending
       output a desk step completes shows what it awaits and the CLI that completes it with a Copy; the form itself arrives with U8b. -->
  <Border x:Name="FactsBlock" Classes="frame-panel" AutomationProperties.Name="{Binding Name}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Group">
    <Expander x:Name="FactsDisclosure" Header="{Binding Heading}" IsExpanded="{Binding IsOpen, Mode=TwoWay}">
    <StackPanel Spacing="8">
      <TextBlock x:Name="FactsHint" Classes="caption subtle" Text="{Binding Hint}" TextWrapping="Wrap" />
      <TextBlock x:Name="FactsEmpty" Classes="body muted" Text="{Binding EmptyText}" IsVisible="{Binding !HasRows}" />
      <ItemsControl x:Name="FactRows" ItemsSource="{Binding Rows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="facts:FactRowViewModel">
            <StackPanel Spacing="4" Margin="0,0,0,10">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Grid.Column="0" Margin="0,0,8,0" AutomationProperties.Name="{Binding StatusWords}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
                  <TextBlock Name="FactGlyph" Classes="body-strong" Text="{Binding Glyph}" AutomationProperties.AccessibilityView="Raw" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="2">
                  <WrapPanel Orientation="Horizontal">
                    <TextBlock Name="FactLabel" Classes="body-strong" Text="{Binding Label}" Margin="0,0,8,0" AutomationProperties.Name="{Binding Label}" />
                    <TextBlock Name="FactKey" Classes="caption mono subtle" Text="{Binding Key}" IsVisible="{Binding IsViewing}" VerticalAlignment="Center" />
                  </WrapPanel>
                  <TextBlock Name="FactSummary" Classes="body" Text="{Binding Summary}" TextWrapping="Wrap" />
                  <TextBlock Name="FactMeta" Classes="caption subtle" Text="{Binding Meta}" TextWrapping="Wrap"
                             IsVisible="{Binding Meta, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  <ProgressBar Name="FactProgress" Minimum="0" Maximum="{Binding ProgressTotal}" Value="{Binding ProgressDone}" IsVisible="{Binding HasProgress}" MaxWidth="240"
                               HorizontalAlignment="Left" AutomationProperties.Name="{Binding ProgressText}" />
                  <TextBlock Name="FactProgressText" Classes="caption mono" Text="{Binding ProgressText}" IsVisible="{Binding HasProgress}" AutomationProperties.AccessibilityView="Raw" />
                  <WrapPanel Orientation="Horizontal" IsVisible="{Binding IsAwaiting}">
                    <TextBlock Name="FactPendingCli" Classes="caption mono" Text="{Binding PendingCli}" IsVisible="{Binding HasPendingCli}" VerticalAlignment="Center" Margin="0,0,8,0"
                               AutomationProperties.Name="{Binding PendingCli}" />
                    <Button Name="FactCopyCli" Classes="copy" Content="{Binding CopyingCli.Label}" IsVisible="{Binding HasPendingCli}" Click="OnCopyCli" Margin="0,0,8,0"
                            AutomationProperties.Name="{Binding CopyCliName}" />
                    <Border Classes="pending-chip" AutomationProperties.AccessibilityView="Raw">
                      <TextBlock Name="FactPendingChip" Classes="caption subtle" Text="{Binding PendingChip}" AutomationProperties.AccessibilityView="Raw" />
                    </Border>
                    <TextBlock Name="FactCliAnnouncement" Classes="caption live-region" Classes.live="{Binding CopyingCli.IsAnnouncing}" Width="0" Opacity="0"
                               IsHitTestVisible="False" Text="{Binding CopyingCli.Announcement}" />
                  </WrapPanel>
                </StackPanel>
                <Button Name="FactView" Grid.Column="2" Content="{Binding ViewLabel}" IsVisible="{Binding CanView}" Click="OnView" VerticalAlignment="Top"
                        AutomationProperties.Name="{Binding ViewName}" />
              </Grid>
              <ContentControl Name="FactViewer" Content="{Binding Viewer}" IsVisible="{Binding IsViewing}" Margin="24,0,0,0" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
    </Expander>
  </Border>
</UserControl>
