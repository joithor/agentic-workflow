<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:inst="using:Aw.Sindri.Ui.ViewModels.Instance"
             x:Class="Aw.Sindri.Ui.Views.Instance.StatesBand"
             x:DataType="inst:StatesBandViewModel">
  <!-- The recipe's states in the order the API serves them (screens spec §4.2). Each item is a state with the link that follows it, so a wrap
       never starts a line with a link; a branch sits under its source. The current state reads stronger; a glyph is never the only sign
       (the name carries the words). -->
  <Border x:Name="InstanceBand" Classes="frame-panel">
    <Expander x:Name="BandDisclosure" Header="{Binding Heading}" IsExpanded="False">
    <StackPanel Spacing="8">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <TextBlock x:Name="BandOrderNote" Classes="caption subtle" Text="{Binding OrderNote}" IsVisible="{Binding HasOrderNote}"
                   AutomationProperties.Name="{Binding OrderNote}" />
      </StackPanel>
      <ItemsControl x:Name="StateNodes" ItemsSource="{Binding Nodes}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="inst:StateNodeViewModel">
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,6,6">
              <StackPanel Spacing="2">
                <Border AutomationProperties.Name="{Binding Name}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
                  <TextBlock Name="StateNodeText" Classes="caption mono" Classes.current="{Binding IsCurrent}" Text="{Binding Text}" AutomationProperties.AccessibilityView="Raw" />
                </Border>
                <ItemsControl ItemsSource="{Binding Branches}" IsVisible="{Binding HasBranches}" Margin="12,0,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="inst:StateNodeViewModel">
                      <Border AutomationProperties.Name="{Binding Name}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
                        <TextBlock Name="StateNodeText" Classes="caption mono" Classes.current="{Binding IsCurrent}" Text="{Binding Text}" AutomationProperties.AccessibilityView="Raw" />
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
              <TextBlock Name="StateNodeLink" Classes="caption mono subtle" Text="{Binding Link}" VerticalAlignment="Top" AutomationProperties.AccessibilityView="Raw" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
    </Expander>
  </Border>
</UserControl>
