<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:inst="using:Aw.Sindri.Ui.ViewModels.Instance"
             xmlns:comp="using:Aw.Sindri.Ui.Views.Components"
             x:Class="Aw.Sindri.Ui.Views.Instance.ExpandedStateView"
             x:DataType="inst:ExpandedStateViewModel">
  <!-- The state the instance is in, expanded (screens spec §4.2): the step, the gates, the engine's next sentence whole, the budget and
       timeout lines, the commands the engine lists (a protected one is the lock button; the rest show their CLI with a Copy and a chip
       that says the app does not send them yet), and Cancel, which asks first with Keep focused. Reading comes before acting in the tab
       order: Copy status, then the commands. -->
  <Border x:Name="ExpandedState" Classes="frame-panel" AutomationProperties.Name="{Binding Name}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Group">
    <StackPanel Spacing="8">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Classes="eyebrow" Text="{Binding State}" VerticalAlignment="Center" />
        <Button x:Name="ExpandedCopyStatus" Grid.Column="1" Classes="copy" Content="{Binding StatusCopy.Label}" Click="OnCopyStatus"
                AutomationProperties.Name="{Binding CopyStatusName}" />
        <TextBlock x:Name="ExpandedCopyAnnouncement" Grid.Column="1" Classes="caption live-region" Classes.live="{Binding StatusCopy.IsAnnouncing}" Width="0" Opacity="0"
                   IsHitTestVisible="False" Text="{Binding StatusCopy.Announcement}" />
      </Grid>
      <TextBlock x:Name="ExpandedStep" Classes="caption mono" Text="{Binding StepLine}" IsVisible="{Binding HasStep}" TextWrapping="Wrap" />
      <ItemsControl x:Name="ExpandedGates" ItemsSource="{Binding Gates}" IsVisible="{Binding HasGates}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <TextBlock Classes="caption mono subtle" Text="{Binding}" TextWrapping="Wrap" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock x:Name="ExpandedNext" Classes="body" Text="{Binding Next}" IsVisible="{Binding HasNext}" TextWrapping="Wrap" />
      <TextBlock x:Name="ExpandedBudget" Classes="caption mono" Text="{Binding BudgetLine}" IsVisible="{Binding HasBudget}" TextWrapping="Wrap" />
      <TextBlock x:Name="ExpandedTimeout" Classes="caption mono" Text="{Binding TimeoutLine}" IsVisible="{Binding HasTimeout}" TextWrapping="Wrap" />
      <TextBlock x:Name="ExpandedPaused" Classes="caption mono" Text="{Binding PausedLine}" IsVisible="{Binding IsPaused}" TextWrapping="Wrap" />
      <TextBlock x:Name="ExpandedDrift" Classes="caption mono" Text="{Binding DriftLine}" IsVisible="{Binding HasDrift}" TextWrapping="Wrap" />
      <Button x:Name="ExpandedChild" Content="{Binding Child.Text}" Click="OnChild" HorizontalAlignment="Left"
              IsVisible="{Binding Child, Converter={x:Static ObjectConverters.IsNotNull}}" AutomationProperties.Name="{Binding Child.Name}" />
      <Border x:Name="ExpandedAttach" Classes="pending-chip" HorizontalAlignment="Left" IsVisible="{Binding HasAttach}"
              AutomationProperties.Name="{Binding AttachName}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
        <TextBlock x:Name="ExpandedAttachChip" Classes="caption subtle" Text="{Binding AttachChip}" AutomationProperties.AccessibilityView="Raw" />
      </Border>
      <ItemsControl x:Name="ExpandedCommands" ItemsSource="{Binding Commands}" IsVisible="{Binding HasCommands}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="inst:ExpandedCommandViewModel">
            <WrapPanel Orientation="Horizontal" Margin="0,0,0,6">
              <Button Name="CommandAsk" IsVisible="{Binding IsCancel}" Content="{Binding Label}" Click="OnAsk" Margin="0,0,8,0" AutomationProperties.Name="{Binding Name}" />
              <TextBlock Name="CommandLabel" Classes="body-strong" Text="{Binding Label}" IsVisible="{Binding ShowsLabel}" VerticalAlignment="Center" Margin="0,0,8,0"
                         AutomationProperties.Name="{Binding Name}" />
              <Panel IsVisible="{Binding Protected, Converter={x:Static ObjectConverters.IsNotNull}}" Margin="0,0,8,0">
                <comp:ProtectedActionButton DataContext="{Binding Protected}" />
              </Panel>
              <TextBlock Name="CommandCli" Classes="caption mono" Text="{Binding Cli}" IsVisible="{Binding ShowsCli}" VerticalAlignment="Center" Margin="0,0,8,0"
                         AutomationProperties.Name="{Binding Cli}" />
              <Button Name="CommandCopy" Classes="copy" Content="{Binding CliCopy.Label}" IsVisible="{Binding ShowsCli}" Click="OnCopyCommand" Margin="0,0,8,0"
                      AutomationProperties.Name="{Binding CopyName}" />
              <TextBlock Name="CommandCopyAnnouncement" Classes="caption live-region" Classes.live="{Binding CliCopy.IsAnnouncing}" Width="0" Opacity="0"
                         IsHitTestVisible="False" Text="{Binding CliCopy.Announcement}" />
              <Border Classes="pending-chip" IsVisible="{Binding ShowsCli}" AutomationProperties.AccessibilityView="Raw">
                <TextBlock Name="CommandPending" Classes="caption subtle" Text="{Binding PendingChip}" AutomationProperties.AccessibilityView="Raw" />
              </Border>
            </WrapPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Border x:Name="ExpandedConfirm" Classes="confirm" IsVisible="{Binding IsConfirmingCancel}">
        <StackPanel Spacing="8">
          <TextBlock x:Name="ExpandedConfirmLine" Classes="body" Text="{Binding ConfirmLine}" TextWrapping="Wrap" AutomationProperties.Name="{Binding ConfirmLine}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="ExpandedKeep" Content="{Binding KeepLabel}" Click="OnKeep" AutomationProperties.Name="{Binding KeepName}" />
            <Button x:Name="ExpandedConfirmCancel" Content="{Binding ConfirmCancelLabel}" Click="OnConfirmCancel" AutomationProperties.Name="{Binding ConfirmCancelName}" />
          </StackPanel>
        </StackPanel>
      </Border>
      <TextBlock x:Name="ExpandedPendingNote" Classes="caption subtle" Text="{Binding PendingNote}" TextWrapping="Wrap"
                 IsVisible="{Binding PendingNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>
  </Border>
</UserControl>
