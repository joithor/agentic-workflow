<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:inst="using:Aw.Sindri.Ui.ViewModels.Instance"
             xmlns:ctl="using:Aw.Sindri.Ui.Views.Controls"
             xmlns:comp="using:Aw.Sindri.Ui.Views.Components"
             x:Class="Aw.Sindri.Ui.Views.Instance.ChildRowView"
             x:DataType="inst:ChildRowViewModel">
  <!-- One child (screens spec §4.2): its mark and served chip, its title (a button that opens the child's frame by its id), the state, round,
       agent and age as served (blank while the engine serves none), the park it mirrors, and its actions. Open opens the item's sheet; the
       agent launch and every other action show what they are, and send nothing from here. -->
  <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,0,0,6">
    <Border Grid.Column="0" Margin="0,2,8,0" AutomationProperties.Name="{Binding State}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
      <TextBlock x:Name="ChildGlyph" Classes="body-strong" Text="{Binding Glyph}" AutomationProperties.AccessibilityView="Raw" />
    </Border>
    <ctl:StateChipView x:Name="ChildChip" Grid.Column="1" Chip="{Binding Chip}" VerticalAlignment="Top" Margin="0,2,8,0" />
    <StackPanel Grid.Column="2" Spacing="2">
      <Button x:Name="ChildRowOpen" Classes="row-title" Click="OnOpenFrame" HorizontalAlignment="Left" AutomationProperties.Name="{Binding OpenFrameName}">
        <TextBlock Classes="body-strong" Text="{Binding Title}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
      </Button>
      <TextBlock x:Name="ChildMeta" Classes="caption mono subtle" Text="{Binding Meta}" TextWrapping="Wrap" />
      <TextBlock x:Name="ChildMirrored" Classes="caption" Text="{Binding MirroredText}" IsVisible="{Binding HasMirrored}" TextWrapping="Wrap" AutomationProperties.Name="{Binding MirroredText}" />
      <TextBlock x:Name="ChildBadge" Classes="caption" Text="{Binding BadgeText}" IsVisible="{Binding HasBadge}" TextWrapping="Wrap" AutomationProperties.Name="{Binding BadgeText}" />
    </StackPanel>
    <WrapPanel Grid.Column="3" Orientation="Horizontal" MaxWidth="320" VerticalAlignment="Top">
      <Button x:Name="ChildRowItemOpen" Content="Open" IsVisible="{Binding CanOpenItem}" Click="OnOpenItem" Margin="0,0,8,4" AutomationProperties.Name="{Binding OpenName}" />
      <Border Classes="pending-chip" IsVisible="{Binding HasLaunchChip}" Margin="0,0,8,4" AutomationProperties.AccessibilityView="Raw">
        <TextBlock x:Name="ChildLaunchChip" Classes="caption subtle" Text="{Binding LaunchChip}" AutomationProperties.AccessibilityView="Raw" />
      </Border>
      <ItemsControl x:Name="ChildActions" ItemsSource="{Binding Actions}" IsVisible="{Binding HasActions}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="inst:ChildActionViewModel">
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,8,4">
              <Panel IsVisible="{Binding Protected, Converter={x:Static ObjectConverters.IsNotNull}}">
                <comp:ProtectedActionButton DataContext="{Binding Protected}" />
              </Panel>
              <Border Classes="pending-chip" IsVisible="{Binding IsPending}" AutomationProperties.Name="{Binding Name}" AutomationProperties.AccessibilityView="Control"
                      AutomationProperties.ControlTypeOverride="Text">
                <TextBlock Name="ChildActionChip" Classes="caption subtle" Text="{Binding PendingChip}" AutomationProperties.AccessibilityView="Raw" />
              </Border>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </WrapPanel>
  </Grid>
</UserControl>
