<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sv="using:Aw.Sindri.Ui.ViewModels.Setup"
             x:Class="Aw.Sindri.Ui.Views.Setup.SetupOnyxForm"
             x:DataType="sv:SetupOnyxViewModel">
  <!-- The Onyx step's controls (setup spec §2.4, §5): Set up and Not now, the login form once Onyx waits for it (two labelled fields, a show toggle, errors under the field they belong
       to, Esc closes it), and Connect to open it again. -->
  <StackPanel Spacing="8">
    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ShowStart}">
      <Button x:Name="SetupOnyxStart" Classes="command-control primary" Click="OnStart" AutomationProperties.Name="{Binding StartText}">
        <TextBlock Classes="button" Text="{Binding StartText}" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
      </Button>
      <Button x:Name="SetupOnyxDefer" Classes="command-control" IsVisible="{Binding ShowDefer}" Click="OnDefer" AutomationProperties.Name="{Binding DeferText}">
        <TextBlock Classes="button" Text="{Binding DeferText}" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
      </Button>
    </StackPanel>
    <Button x:Name="SetupOnyxOpen" Classes="command-control primary" HorizontalAlignment="Left" IsVisible="{Binding ShowConnect}" Click="OnOpen" AutomationProperties.Name="{Binding ConnectText}">
      <TextBlock Classes="button" Text="{Binding ConnectText}" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
    </Button>
    <StackPanel x:Name="SetupOnyxFormPanel" Spacing="8" IsVisible="{Binding ShowForm}">
      <Border AutomationProperties.Name="{Binding IntroText}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
        <TextBlock Classes="caption" Text="{Binding IntroText}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
      </Border>
      <StackPanel Spacing="4">
        <TextBlock Classes="caption muted" Text="{Binding EmailLabel}" AutomationProperties.AccessibilityView="Raw" />
        <TextBox x:Name="SetupOnyxEmail" Text="{Binding Email, Mode=TwoWay}" AutomationProperties.Name="{Binding EmailLabel}" KeyDown="OnFieldKey" />
        <Border x:Name="SetupOnyxEmailError" Classes="error-panel" IsVisible="{Binding HasEmailError}" AutomationProperties.Name="{Binding EmailError}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
          <TextBlock Classes="caption" Text="{Binding EmailError}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
        </Border>
      </StackPanel>
      <StackPanel Spacing="4">
        <TextBlock Classes="caption muted" Text="{Binding PasswordLabel}" AutomationProperties.AccessibilityView="Raw" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBox x:Name="SetupOnyxPassword" Text="{Binding Password, Mode=TwoWay}" PasswordChar="{Binding PasswordChar}" AutomationProperties.Name="{Binding PasswordLabel}" KeyDown="OnFieldKey" />
          <ToggleButton x:Name="SetupOnyxReveal" Grid.Column="1" IsChecked="{Binding IsRevealed, Mode=OneWay}" IsCheckedChanged="OnRevealChanged" AutomationProperties.Name="{Binding RevealText}">
            <TextBlock Classes="button" Text="{Binding RevealText}" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
          </ToggleButton>
        </Grid>
        <Border x:Name="SetupOnyxPasswordError" Classes="error-panel" IsVisible="{Binding HasPasswordError}" AutomationProperties.Name="{Binding PasswordError}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
          <TextBlock Classes="caption" Text="{Binding PasswordError}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
        </Border>
      </StackPanel>
      <Border x:Name="SetupOnyxFormError" Classes="error-panel" IsVisible="{Binding HasFormError}" AutomationProperties.Name="{Binding FormError}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
        <TextBlock Classes="caption" Text="{Binding FormError}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
      </Border>
      <Button x:Name="SetupOnyxConnect" Classes="command-control primary" HorizontalAlignment="Left" IsEnabled="{Binding !IsSending}" Click="OnConnect" AutomationProperties.Name="{Binding ConnectText}">
        <TextBlock Classes="button" Text="{Binding ConnectText}" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
      </Button>
      <Border AutomationProperties.Name="{Binding NoteText}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
        <TextBlock Classes="caption subtle" Text="{Binding NoteText}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
      </Border>
    </StackPanel>
  </StackPanel>
</UserControl>
