<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Aw.Sindri.Ui.ViewModels"
        xmlns:shell="using:Aw.Sindri.Ui.ViewModels.Shell"
        xmlns:views="using:Aw.Sindri.Ui.Views.Shell"
        xmlns:icons="using:Aw.Sindri.Ui.Views.Icons"
        x:Class="Aw.Sindri.Ui.Views.Shell.ShellWindow"
        x:DataType="shell:ShellViewModel"
        Title="{Binding Text.Sindri}"
        Width="1280" Height="800"
        MinWidth="{StaticResource Size.WindowMinWidth}" MinHeight="{StaticResource Size.WindowMinHeight}">
  <!-- The shell (UI spec §3.2, §4.1): a top bar, the page, and the detail sheet over it; a version mismatch takes the whole
       window. Each pre-API state is a panel the view model makes visible; the view decides nothing. -->
  <Window.Styles>
    <StyleInclude Source="avares://Aw.Sindri.Ui/Views/Shell/ShellStyles.axaml" />
  </Window.Styles>

  <Panel>
    <!-- Version mismatch (§4.1, states.html): a full-window card, no data, no actions: the sentence, both versions as
         labelled rows, and the fix, with sindri in the command chip. -->
    <Border x:Name="VersionMismatchPanel" IsVisible="{Binding IsVersionMismatch}" Classes="card state-card"
            HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel Spacing="{StaticResource Space.SM}">
        <TextBlock x:Name="VersionMismatchText" Classes="detail-title" TextWrapping="Wrap"
                   Text="{Binding Text.VersionMismatch}" AutomationProperties.Name="{Binding Text.VersionMismatch}" />
        <ItemsControl x:Name="VersionRows" ItemsSource="{Binding Health.Detail.Versions}" AutomationProperties.Name="{Binding Reason}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:HealthCell">
              <Grid ColumnDefinitions="80,*" AutomationProperties.Name="{Binding Label}">
                <TextBlock Classes="caption subtle" Text="{Binding Label}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Label}" />
                <TextBlock Grid.Column="1" Classes="mono" Text="{Binding Value}" AutomationProperties.Name="{Binding Value}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <!-- N4: the fix as a sentence around sindri in the mono command chip; the line is named by the whole sentence. -->
        <StackPanel x:Name="VersionFix" Orientation="Horizontal" Spacing="10" AutomationProperties.Name="{Binding Text.VersionMismatchFix}">
          <TextBlock x:Name="VersionFixText" Classes="body muted" Text="{Binding Text.VersionMismatchFixLead}" VerticalAlignment="Center"
                     AutomationProperties.Name="{Binding Text.VersionMismatchFixLead}" />
          <Border Classes="command">
            <TextBlock x:Name="VersionFixCommand" Classes="mono" Text="{Binding Text.StartFix}"
                       AutomationProperties.Name="{Binding Text.StartFix}" />
          </Border>
        </StackPanel>
      </StackPanel>
    </Border>

    <DockPanel IsVisible="{Binding IsChromeVisible}">
      <views:TopBar x:Name="TopBar" DockPanel.Dock="Top" />

      <!-- The attention band (§3.2): hidden until needs-you is served (U3). -->
      <Border x:Name="AttentionBand" DockPanel.Dock="Top" Height="{StaticResource Size.AttentionBand}"
              Background="{DynamicResource Brush.Attention}" IsVisible="{Binding IsAttentionBandVisible}"
              AutomationProperties.Name="{Binding Text.NeedsYouPanel}" />

      <!-- Stale after three failed refreshes (§4.1): "Sindri not responding: run sindri doctor" in full under the top bar,
           since the pill keeps ⌛ stale and its Refresh at the 900 px minimum. -->
      <Border x:Name="NotRespondingBanner" DockPanel.Dock="Top" Classes="banner" IsVisible="{Binding IsNotRespondingBanner}"
              AutomationProperties.Name="{Binding Text.NotResponding}">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <icons:StateIcon Glyph="Stale" VerticalAlignment="Center" />
          <TextBlock x:Name="NotRespondingText" Classes="body" Text="{Binding Text.NotRespondingLead}" VerticalAlignment="Center"
                     AutomationProperties.Name="{Binding Text.NotRespondingLead}" />
          <Border Classes="command">
            <TextBlock x:Name="NotRespondingFixText" Classes="mono" Text="{Binding Text.DoctorFix}"
                       AutomationProperties.Name="{Binding Text.DoctorFix}" />
          </Border>
        </StackPanel>
      </Border>

      <!-- Unreadable (§4.1): a banner with the code and sindri doctor; the page below keeps its last data. -->
      <Border x:Name="UnreadableBanner" DockPanel.Dock="Top" Classes="banner" IsVisible="{Binding IsUnreadable}">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <icons:StateIcon Glyph="Down" VerticalAlignment="Center" />
          <TextBlock Classes="body-strong" Text="{Binding Text.Unreadable}" VerticalAlignment="Center"
                     AutomationProperties.Name="{Binding Text.Unreadable}" />
          <TextBlock x:Name="UnreadableText" Classes="body" Text="{Binding Reason}" TextWrapping="Wrap"
                     AutomationProperties.Name="{Binding Reason}" />
          <TextBlock Classes="body subtle" Text="{Binding Text.CheckIt}" AutomationProperties.Name="{Binding Text.CheckIt}" />
          <Border Classes="command">
            <TextBlock x:Name="DoctorFixText" Classes="mono" Text="{Binding Text.DoctorFix}"
                       AutomationProperties.Name="{Binding Text.DoctorFix}" />
          </Border>
        </StackPanel>
      </Border>

      <Panel>
        <Border x:Name="Page" Classes="focus-region" Focusable="True" AutomationProperties.Name="{Binding PageName}">
          <Panel>
            <!-- Connecting (§4.1, states.html): Home's frame with static, left-aligned skeleton bars, first load only. -->
            <StackPanel x:Name="ConnectingSkeleton" IsVisible="{Binding IsConnecting}" Margin="{StaticResource Space.LG.Thickness}"
                        Spacing="{StaticResource Size.PanelGap}">
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.SM}">
                <TextBlock Classes="page-title" Text="{Binding Text.Home}" AutomationProperties.Name="{Binding Text.Home}" />
                <Border Classes="skeleton" Width="180" VerticalAlignment="Center" />
              </StackPanel>
              <Border Classes="panel">
                <StackPanel>
                  <Border Classes="phead">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Classes="eyebrow" Text="{Binding Text.NeedsYouPanel}" VerticalAlignment="Center"
                                 AutomationProperties.Name="{Binding Text.NeedsYouPanel}" />
                      <TextBlock x:Name="ConnectingText" Grid.Column="1" Classes="caption subtle" Text="{Binding Text.Connecting}"
                                 VerticalAlignment="Center" AutomationProperties.Name="{Binding Text.Connecting}" />
                    </Grid>
                  </Border>
                  <Grid Classes="skrow" ColumnDefinitions="70,*,40"><Border Classes="skeleton" Width="60" /><Border Grid.Column="1" Classes="skeleton" Width="420" /><Border Grid.Column="2" Classes="skeleton" Width="32" /></Grid>
                  <Grid Classes="skrow" ColumnDefinitions="70,*,40"><Border Classes="skeleton" Width="52" /><Border Grid.Column="1" Classes="skeleton" Width="330" /><Border Grid.Column="2" Classes="skeleton" Width="32" /></Grid>
                  <Grid Classes="skrow" ColumnDefinitions="70,*,40"><Border Classes="skeleton" Width="64" /><Border Grid.Column="1" Classes="skeleton" Width="480" /><Border Grid.Column="2" Classes="skeleton" Width="32" /></Grid>
                  <Grid Classes="skrow" ColumnDefinitions="70,*,40"><Border Classes="skeleton" Width="48" /><Border Grid.Column="1" Classes="skeleton" Width="270" /><Border Grid.Column="2" Classes="skeleton" Width="32" /></Grid>
                </StackPanel>
              </Border>
              <Grid ColumnDefinitions="*,16,*">
                <Border Classes="panel" Padding="{StaticResource Space.MD.Thickness}">
                  <Border Classes="skeleton" Width="240" />
                </Border>
                <Border Grid.Column="2" Classes="panel" Padding="{StaticResource Space.MD.Thickness}">
                  <Border Classes="skeleton" Width="180" />
                </Border>
              </Grid>
            </StackPanel>

            <!-- Not running (§4.1, states.html): a compact card centred in the page: the struck ◆ mark (the tray's
                 not-running mark) and the word, the reason, and sindri to run. -->
            <Border x:Name="NotRunningPanel" Classes="card state-card" IsVisible="{Binding IsNotRunning}"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
              <StackPanel Spacing="{StaticResource Space.SM}">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.XS}">
                  <Path x:Name="NotRunningMark" Classes="struck-mark" Data="M8,2 L14,8 L8,14 L2,8 Z M2,2 L14,14"
                        VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                  <TextBlock x:Name="NotRunningText" Classes="detail-title" Text="{Binding Text.NotRunning}"
                             AutomationProperties.Name="{Binding Text.NotRunning}" />
                </StackPanel>
                <TextBlock x:Name="ReasonText" Classes="body muted" Text="{Binding Reason}" TextWrapping="Wrap"
                           AutomationProperties.Name="{Binding Reason}" />
                <!-- I7: the reason's detail on its own mono line: the record's path shortened (~, a middle ellipsis), the address, or
                     the record against the answer; never wrapped mid-path. -->
                <TextBlock x:Name="ReasonDetailText" Classes="mono subtle" Text="{Binding ReasonDetail}" TextWrapping="NoWrap"
                           TextTrimming="PrefixCharacterEllipsis" IsVisible="{Binding ReasonDetail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           AutomationProperties.Name="{Binding ReasonDetail}" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Classes="body subtle" Text="{Binding Text.StartIt}" AutomationProperties.Name="{Binding Text.StartIt}" VerticalAlignment="Center" />
                  <Border Classes="command">
                    <TextBlock x:Name="FixText" Classes="mono" Text="{Binding Text.StartFix}"
                               AutomationProperties.Name="{Binding Text.StartFix}" />
                  </Border>
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- The pages (§3.3), each shown by the view model's page flag. -->
            <ScrollViewer x:Name="Pages" IsVisible="{Binding IsPageVisible}">
              <Panel x:Name="PageContent" Classes="page-content" Classes.edge="{Binding IsEdgeTabShown}">
                <views:HomePage x:Name="HomePage" IsVisible="{Binding IsHome}" />
                <views:PlaceholderPage x:Name="QueuePage" Title="{Binding Text.Queue}" IsVisible="{Binding IsQueue}" />
                <views:PlaceholderPage x:Name="DecisionsPage" Title="{Binding Text.Decisions}" IsVisible="{Binding IsDecisions}" />
                <views:PlaceholderPage x:Name="ServicesPage" Title="{Binding Text.Services}" IsVisible="{Binding IsServices}" />
                <Panel IsVisible="{Binding IsHealth}">
                  <views:HealthPage x:Name="HealthPage" DataContext="{Binding Health}" />
                </Panel>
                <!-- Settings (⌘,): SindriApp puts Settings' view here at start-up; the placeholder shows where nothing does (view tests). -->
                <ContentControl x:Name="SettingsSlot" IsVisible="{Binding IsSettings}">
                  <views:PlaceholderPage Title="{Binding Text.Settings}" />
                </ContentControl>
              </Panel>
            </ScrollViewer>
          </Panel>
        </Border>

        <!-- The closed sheet's edge tab: the last subject, which reopens it. -->
        <Button x:Name="EdgeTab" Classes="edge-tab" IsVisible="{Binding IsEdgeTabShown}" Click="OnEdgeTab"
                HorizontalAlignment="Right" VerticalAlignment="Center"
                AutomationProperties.Name="{Binding EdgeTabName}">
          <LayoutTransformControl>
            <LayoutTransformControl.LayoutTransform>
              <RotateTransform Angle="-90" />
            </LayoutTransformControl.LayoutTransform>
            <TextBlock Classes="mono" Text="{Binding SheetSubject}" />
          </LayoutTransformControl>
        </Button>

        <!-- The detail sheet (§3.2): over the page at the right, 420–760 px wide; below 1100 px it covers the page. -->
        <Border x:Name="Sheet" Classes="sheet focus-region" IsVisible="{Binding IsSheetShown}" Focusable="True"
                AutomationProperties.Name="{Binding SheetSubject}">
          <DockPanel>
            <Thumb x:Name="SheetGrip" Classes="sheet-grip" DockPanel.Dock="Left" Cursor="SizeWestEast"
                   DragDelta="OnSheetDrag" DragCompleted="OnSheetDragged"
                   AutomationProperties.Name="{Binding Text.Sheet}" />
            <StackPanel Margin="24,16" Spacing="12">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Button x:Name="SheetBack" Classes="back" Content="{Binding Text.Back}" Click="OnCloseSheet"
                        AutomationProperties.Name="{Binding Text.Back}" Margin="0,0,12,0" />
                <TextBlock x:Name="SheetTitle" Grid.Column="1" Classes="detail-title mono" Focusable="True"
                           Text="{Binding SheetSubject}" AutomationProperties.Name="{Binding SheetSubject}"
                           VerticalAlignment="Center" />
                <Button x:Name="SheetClose" Grid.Column="2" Click="OnCloseSheet" Margin="12,0,0,0"
                        AutomationProperties.Name="{Binding Text.CloseSheet}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <icons:StateIcon Icon="Close" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Text.CloseSheet}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </Grid>
              <TextBlock x:Name="SheetBody" Classes="body muted" Text="{Binding Text.NotServedYet}"
                         AutomationProperties.Name="{Binding Text.NotServedYet}" />
            </StackPanel>
          </DockPanel>
        </Border>
      </Panel>
    </DockPanel>
  </Panel>
</Window>
