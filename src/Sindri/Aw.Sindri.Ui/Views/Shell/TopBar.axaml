<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="using:Aw.Sindri.Ui.ViewModels.Shell"
             x:Class="Aw.Sindri.Ui.Views.Shell.TopBar"
             x:DataType="shell:ShellViewModel">
  <!-- The top bar (UI spec §3.2): brand, the segmented navigation with its counts, Later ▾, the ⌘K field (a placeholder
       until U1's palette) and the health pill, which opens Health. The ⌘K field's column is a star column that outweighs the
       spacer and stops at 300 px plus its margins: with room it is 300 px wide at the right, and as the window narrows it
       is what gives way (down to 160 px), so the pill and the navigation fit from the 900 px minimum up. -->
  <Border Classes="topbar focus-region" Focusable="True" AutomationProperties.Name="{Binding Text.Sindri}">
    <Grid VerticalAlignment="Center">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="100*" MinWidth="184" MaxWidth="324" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,20,0">
        <TextBlock Classes="detail-title brand" Text="◆" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
        <TextBlock Classes="body-strong" Text="{Binding Text.Sindri}" VerticalAlignment="Center"
                   AutomationProperties.Name="{Binding Text.Sindri}" />
      </StackPanel>

      <ListBox x:Name="Navigation" Grid.Column="1" Classes="nav" ItemsSource="{Binding Navigation}"
               SelectedItem="{Binding SelectedNav}" SelectionMode="Single"
               AutomationProperties.Name="{Binding Text.Pages}">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.Styles>
          <Style Selector="ListBoxItem" x:DataType="shell:NavEntry">
            <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="shell:NavEntry">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Classes="body-strong" Text="{Binding Label}" AutomationProperties.Name="{Binding Label}" />
              <TextBlock Classes="caption subtle" Text="{Binding Count}" AutomationProperties.Name="{Binding Count}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <Button x:Name="LaterButton" Grid.Column="2" Classes="later" Margin="4,0,0,0"
              AutomationProperties.Name="{Binding Text.Later}">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <TextBlock Classes="body-strong muted" Text="{Binding Text.Later}" AutomationProperties.Name="{Binding Text.Later}" />
          <TextBlock Classes="caption subtle" Text="▾" />
        </StackPanel>
        <Button.Flyout>
          <Flyout Placement="BottomEdgeAlignedLeft">
            <ItemsControl x:Name="LaterList" ItemsSource="{Binding Later}" AutomationProperties.Name="{Binding Text.Later}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="shell:LaterEntry">
                  <Grid ColumnDefinitions="140,Auto" Margin="4,6" AutomationProperties.Name="{Binding Label}">
                    <TextBlock Classes="body muted" Text="{Binding Label}" AutomationProperties.Name="{Binding Label}" />
                    <TextBlock Grid.Column="1" Classes="caption subtle" Text="{Binding Note}" AutomationProperties.Name="{Binding Note}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Flyout>
        </Button.Flyout>
      </Button>

      <Border x:Name="SearchField" Grid.Column="4" Classes="search" Margin="12,0,12,0" Focusable="True"
              AutomationProperties.Name="{Binding Text.Search}">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Border Classes="kbd">
            <TextBlock Classes="kbd" Text="{Binding Text.SearchKey}" AutomationProperties.Name="{Binding Text.SearchKey}" />
          </Border>
          <TextBlock Classes="caption subtle" Text="{Binding Text.Search}" AutomationProperties.Name="{Binding Text.Search}" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Border>

      <!-- The health pill (§3.2, §11.3): a dot and a glyph before the state's word, then the age; it opens Health.
           While stale, Refresh sits beside it (§4.1). -->
      <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button x:Name="RefreshButton" Classes="refresh" IsVisible="{Binding Pill.IsRefreshShown}" Click="OnRefresh"
                AutomationProperties.Name="{Binding Text.Refresh}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Classes="caption subtle" Text="⟳" AutomationProperties.AccessibilityView="Raw" />
            <TextBlock Classes="caption" Text="{Binding Text.Refresh}" />
          </StackPanel>
        </Button>
        <Button x:Name="HealthPill" Classes="health-pill" Click="OnHealthPill"
                AutomationProperties.Name="{Binding Pill.Text}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Ellipse x:Name="PillDot" Classes="pill-dot" Classes.ok="{Binding Pill.IsHealthy}"
                     Classes.stale="{Binding Pill.IsStale}" Classes.down="{Binding Pill.IsDown}" VerticalAlignment="Center" />
            <TextBlock x:Name="PillGlyph" Classes="caption pill-glyph" Classes.ok="{Binding Pill.IsHealthy}"
                       Classes.down="{Binding Pill.IsDown}" Text="{Binding Pill.Glyph}" VerticalAlignment="Center"
                       AutomationProperties.AccessibilityView="Raw" />
            <TextBlock x:Name="HealthPillText" Classes="body-strong" Text="{Binding Pill.Word}" VerticalAlignment="Center" />
            <TextBlock x:Name="PillAgeText" Classes="caption subtle" Text="{Binding Pill.Age}" IsVisible="{Binding Pill.HasAge}"
                       VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
