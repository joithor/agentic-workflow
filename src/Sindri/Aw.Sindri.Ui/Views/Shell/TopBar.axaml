<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="using:Aw.Sindri.Ui.ViewModels.Shell"
             x:Class="Aw.Sindri.Ui.Views.Shell.TopBar"
             x:DataType="shell:ShellViewModel">
  <!-- The top bar (UI spec §3.2): brand, the segmented navigation with its counts, Later ▾, the ⌘K field (a placeholder
       until U1's palette) and the health pill, which opens Health. -->
  <Border Classes="topbar" Focusable="True" AutomationProperties.Name="{Binding Text.Sindri}">
    <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto" VerticalAlignment="Center">
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,20,0">
        <Border Classes="brand" />
        <TextBlock Classes="body-strong" Text="{Binding Text.Sindri}" VerticalAlignment="Center"
                   AutomationProperties.Name="{Binding Text.Sindri}" />
      </StackPanel>

      <ListBox x:Name="Navigation" Grid.Column="1" Classes="nav" ItemsSource="{Binding Navigation}"
               SelectedItem="{Binding SelectedNav}" SelectionMode="Single"
               AutomationProperties.Name="{Binding Text.Pages}">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.Styles>
          <Style Selector="ListBoxItem" x:DataType="shell:NavEntry">
            <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="shell:NavEntry">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Classes="body-strong" Text="{Binding Label}" AutomationProperties.Name="{Binding Label}" />
              <TextBlock Classes="caption subtle" Text="{Binding Count}" AutomationProperties.Name="{Binding Count}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <Button x:Name="LaterButton" Grid.Column="2" Classes="later" Margin="4,0,0,0"
              AutomationProperties.Name="{Binding Text.Later}">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <TextBlock Classes="body-strong muted" Text="{Binding Text.Later}" AutomationProperties.Name="{Binding Text.Later}" />
          <TextBlock Classes="caption subtle" Text="▾" />
        </StackPanel>
        <Button.Flyout>
          <Flyout Placement="BottomEdgeAlignedLeft">
            <ItemsControl x:Name="LaterList" ItemsSource="{Binding Later}" AutomationProperties.Name="{Binding Text.Later}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="shell:LaterEntry">
                  <Grid ColumnDefinitions="140,Auto" Margin="4,6" AutomationProperties.Name="{Binding Label}">
                    <TextBlock Classes="body muted" Text="{Binding Label}" AutomationProperties.Name="{Binding Label}" />
                    <TextBlock Grid.Column="1" Classes="caption subtle" Text="{Binding Note}" AutomationProperties.Name="{Binding Note}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Flyout>
        </Button.Flyout>
      </Button>

      <Border x:Name="SearchField" Grid.Column="4" Classes="search" Margin="0,0,12,0"
              AutomationProperties.Name="{Binding Text.Search}">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Border Classes="kbd">
            <TextBlock Classes="kbd" Text="{Binding Text.SearchKey}" AutomationProperties.Name="{Binding Text.SearchKey}" />
          </Border>
          <TextBlock Classes="caption subtle" Text="{Binding Text.Search}" AutomationProperties.Name="{Binding Text.Search}" VerticalAlignment="Center" />
        </StackPanel>
      </Border>

      <Button x:Name="HealthPill" Grid.Column="5" Classes="health-pill" Click="OnHealthPill"
              AutomationProperties.Name="{Binding HealthPill}">
        <TextBlock x:Name="HealthPillText" Classes="caption" Text="{Binding HealthPill}"
                   AutomationProperties.Name="{Binding HealthPill}" />
      </Button>
    </Grid>
  </Border>
</UserControl>
