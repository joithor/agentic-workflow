<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aw.Sindri.Ui.ViewModels"
             xmlns:shell="using:Aw.Sindri.Ui.ViewModels.Shell"
             x:Class="Aw.Sindri.Ui.Views.Shell.HealthPage"
             x:DataType="shell:HealthViewModel">
  <!-- Health (UI spec §4.8, §15): S1b's status card, the same status 'sindri status' prints. -->
  <StackPanel Spacing="16">
    <StackPanel Orientation="Horizontal" Spacing="12">
      <TextBlock Classes="page-title" Text="{Binding Text.Health}" AutomationProperties.Name="{Binding Text.Health}"
                 VerticalAlignment="Center" />
      <Border Classes="pill" Classes.down="{Binding !IsRunning}">
        <TextBlock x:Name="HeadlineText" Classes="caption" Text="{Binding Headline}" AutomationProperties.Name="{Binding Headline}" />
      </Border>
    </StackPanel>

    <Grid ColumnDefinitions="*,16,*">
      <Border Classes="card">
        <StackPanel>
          <TextBlock Classes="eyebrow" Text="{Binding Text.LeaseCard}" AutomationProperties.Name="{Binding Text.LeaseCard}" />
          <TextBlock x:Name="LeaseText" Classes="title" Text="{Binding Lease}" AutomationProperties.Name="{Binding Lease}" />
          <TextBlock x:Name="ApiText" Classes="subtle" Text="{Binding Api}" AutomationProperties.Name="{Binding Api}" Margin="0,6,0,0" />
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Classes="card">
        <StackPanel>
          <TextBlock Classes="eyebrow" Text="{Binding Text.ProfileCard}" AutomationProperties.Name="{Binding Text.ProfileCard}" />
          <TextBlock x:Name="ProfileStateText" Classes="title" Text="{Binding ProfileState}"
                     AutomationProperties.Name="{Binding ProfileState}" />
          <TextBlock x:Name="ProfileDetailText" Classes="subtle" Text="{Binding ProfileDetail}" TextWrapping="Wrap"
                     AutomationProperties.Name="{Binding ProfileDetail}" Margin="0,6,0,0" />
          <Border Classes="command" Margin="0,10,0,0" IsVisible="{Binding HasProfileFix}">
            <TextBlock x:Name="ProfileFixText" Classes="mono" Text="{Binding ProfileFix}"
                       AutomationProperties.Name="{Binding ProfileFix}" />
          </Border>
        </StackPanel>
      </Border>
    </Grid>

    <Border Classes="card">
      <StackPanel>
        <TextBlock Classes="eyebrow" Text="{Binding Text.ServicesCard}" AutomationProperties.Name="{Binding Text.ServicesCard}" />
        <ItemsControl x:Name="ServicesList" ItemsSource="{Binding Services}" AutomationProperties.Name="{Binding Text.Services}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ServiceRow">
              <Grid ColumnDefinitions="140,*,Auto" Margin="0,6" AutomationProperties.Name="{Binding Name}">
                <TextBlock Classes="body-strong" Text="{Binding Name}" AutomationProperties.Name="{Binding Name}" />
                <TextBlock Grid.Column="1" Classes="body muted" Text="{Binding Cadence}" AutomationProperties.Name="{Binding Cadence}" />
                <TextBlock Grid.Column="2" Classes="mono" Text="{Binding LastRun}" AutomationProperties.Name="{Binding LastRun}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Classes="subtle" Text="{Binding Text.NoServices}" IsVisible="{Binding !HasServices}"
                   AutomationProperties.Name="{Binding Text.NoServices}" />
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel>
        <TextBlock Classes="eyebrow" Text="{Binding Text.LastEventCard}" AutomationProperties.Name="{Binding Text.LastEventCard}" />
        <TextBlock x:Name="LastEventText" Classes="mono" Text="{Binding LastEvent}" AutomationProperties.Name="{Binding LastEvent}" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
