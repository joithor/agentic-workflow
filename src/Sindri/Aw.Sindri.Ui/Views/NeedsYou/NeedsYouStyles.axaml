<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- The Needs-you rows' tint (screens spec R8-13): the urgency, not a side bar. Tokens only. A pulse row that is unseen keeps
       the attention tint and pulses its border; under reduced motion it keeps a steady outline instead (HasOutline). -->
  <Style Selector="Border.needs-you-row.pulsing">
    <Setter Property="Background" Value="{DynamicResource Brush.AttentionSoft}" />
    <Style.Animations>
      <Animation Duration="0:0:1.6" IterationCount="Infinite" Easing="SineEaseInOut">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.75" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="Border.needs-you-row.outlined">
    <Setter Property="Background" Value="{DynamicResource Brush.AttentionSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Attention}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="Border.needs-you-row.stale">
    <Setter Property="Opacity" Value="0.7" />
  </Style>
</Styles>
