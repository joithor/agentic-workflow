<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aw.Sindri.Ui.ViewModels.Controls"
             xmlns:comp="using:Aw.Sindri.Ui.Views.Components"
             x:Class="Aw.Sindri.Ui.Views.Controls.TypedConfirmBox"
             x:DataType="vm:TypedConfirmBoxViewModel">
  <!-- The typed confirmation (setup spec §2.1): "To approve, type" + the served phrase in a chip + the field + the button, one row that wraps.
       A match turns the field's border to Success and shows a tick (never colour alone); Enter in the field presses the button when it is on.
       The lines that change are one static wrapper each, named by a view-model string. Until the catalog row is ready the lock button's terminal
       copy shows in place of all of it. -->
  <StackPanel Spacing="6">
    <StackPanel x:Name="TypedParts" Spacing="6" IsVisible="{Binding IsReady}">
      <WrapPanel Orientation="Horizontal">
        <TextBlock Classes="caption subtle" Text="{Binding Ask}" VerticalAlignment="Center" Margin="0,0,8,6" AutomationProperties.AccessibilityView="Raw" />
        <Border Classes="phrase-chip" VerticalAlignment="Center" Margin="0,0,8,6" AutomationProperties.AccessibilityView="Raw">
          <TextBlock Classes="mono" Text="{Binding Phrase}" />
        </Border>
        <TextBox x:Name="TypedField" Classes="typed-field" Classes.match="{Binding Matches}" Text="{Binding Text}" IsEnabled="{Binding !IsSending}"
                 VerticalAlignment="Center" Margin="0,0,8,6" AutomationProperties.Name="{Binding FieldName}" />
        <TextBlock x:Name="TypedTick" Text="✓" IsVisible="{Binding Matches}" Foreground="{DynamicResource Brush.Success}" VerticalAlignment="Center" Margin="0,0,8,6"
                   AutomationProperties.AccessibilityView="Raw" />
        <Button x:Name="TypedButton" Classes="command-control primary" IsEnabled="{Binding CanSubmit}" VerticalAlignment="Center" Margin="0,0,0,6" Click="OnPress"
                AutomationProperties.Name="{Binding ButtonLabel}">
          <TextBlock Classes="button" Text="{Binding ButtonLabel}" AutomationProperties.AccessibilityView="Raw" />
        </Button>
      </WrapPanel>
      <TextBlock Classes="caption subtle" Text="{Binding Note}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
      <TextBlock x:Name="TypedLive" Classes="caption live-region" Classes.live="{Binding Live.IsAnnouncing}" Text="{Binding Live.Announcement}" Width="0" Opacity="0"
                 IsHitTestVisible="False" HorizontalAlignment="Left" />
    </StackPanel>
    <Border x:Name="TypedTerminal" IsVisible="{Binding !IsReady}">
      <comp:ProtectedActionButton DataContext="{Binding Terminal}" />
    </Border>
  </StackPanel>
</UserControl>
