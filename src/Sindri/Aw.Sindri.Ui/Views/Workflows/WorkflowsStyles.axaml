<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- The Workflows strip's rows while the views are stale: marked by a muted background, kept, the text never faded (screens spec §4.1, WCAG 1.4.3). Tokens only. -->
  <Style Selector="Border.strip-row.stale">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
  </Style>
</Styles>
