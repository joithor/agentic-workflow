<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wf="using:Aw.Sindri.Ui.ViewModels.Workflows"
             xmlns:wfv="using:Aw.Sindri.Ui.Views.Workflows"
             xmlns:icons="using:Aw.Sindri.Ui.Views.Icons"
             xmlns:vm="using:Aw.Sindri.Ui.ViewModels"
             x:Class="Aw.Sindri.Ui.Views.Workflows.WorkflowsPage"
             x:DataType="wf:WorkflowsViewModel">
  <!-- The Workflows page (screens spec §4.2): the head with the root-wide counts and the filters, then the open root runs grouped by
       workflow in the order the API serves them, the finished line collapsed under them, and the shared states. -->
  <StackPanel Spacing="{StaticResource Size.PanelGap}">
    <Grid ColumnDefinitions="Auto,*,Auto">
      <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <TextBlock Classes="page-title" Text="Workflows" AutomationProperties.Name="Workflows" />
        <TextBlock x:Name="WorkflowsHead" Classes="caption subtle" Text="{Binding Head}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Head}" />
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <Button x:Name="WorkflowsStart" Classes="command-control" Click="OnStart" AutomationProperties.Name="{Binding StartLabel}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Classes="button" Text="{Binding StartLabel}" VerticalAlignment="Center" />
            <Border Classes="kbd" VerticalAlignment="Center"><TextBlock Classes="kbd" Text="N" /></Border>
          </StackPanel>
        </Button>
        <ComboBox x:Name="RecipeFilter" ItemsSource="{Binding RecipeChoices}" SelectionChanged="OnRecipeChosen" PlaceholderText="{Binding RecipeFilterName}" MinWidth="180"
                  AutomationProperties.Name="{Binding RecipeFilterName}" />
        <TextBox x:Name="SubjectFilter" PlaceholderText="{Binding SubjectFilterName}" KeyDown="OnSubjectKey" MinWidth="160" AutomationProperties.Name="{Binding SubjectFilterName}" />
      </StackPanel>
    </Grid>

    <StackPanel x:Name="WorkflowsPageStale" Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsStale}">
      <icons:StateIcon Glyph="Stale" VerticalAlignment="Center" />
      <TextBlock Classes="caption subtle" Text="{Binding StaleText}" VerticalAlignment="Center" />
    </StackPanel>

    <!-- A key that only names a later phase (B, N) says so here, politely, and changes nothing. -->
    <TextBlock x:Name="WorkflowsKeyNote" Classes="caption" Text="{Binding KeyNote}" IsVisible="{Binding HasKeyNote}" TextWrapping="Wrap"
               AutomationProperties.Name="{Binding KeyNote}" />
    <TextBlock x:Name="WorkflowsKeyNoteAnnouncement" Classes="caption live-region" Classes.live="{Binding KeyNoteVoice.IsAnnouncing}" Width="0" Opacity="0"
               IsHitTestVisible="False" Text="{Binding KeyNoteVoice.Announcement}" />

    <Border x:Name="WorkflowsPanel" Classes="panel" AutomationProperties.Name="Workflows" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Group">
      <StackPanel>
        <TextBlock x:Name="WorkflowsPageEmpty" Classes="caption quiet" Text="{Binding EmptyText}" Margin="16,8" TextWrapping="Wrap"
                   IsVisible="{Binding IsEmpty}" AutomationProperties.Name="{Binding EmptyText}" />
        <TextBlock x:Name="WorkflowsPageUnreadable" Classes="caption quiet" Text="{Binding UnreadableText}" Margin="16,8" TextWrapping="Wrap"
                   IsVisible="{Binding IsUnreadable}" AutomationProperties.Name="{Binding UnreadableText}" />
        <ItemsControl x:Name="WorkflowGroups" ItemsSource="{Binding Groups}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="wf:RecipeGroupViewModel">
              <wfv:RecipeGroup />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button x:Name="WorkflowsDoneToggle" Classes="group-toggle" Click="OnDoneToggle" IsVisible="{Binding HasDone}" AutomationProperties.Name="{Binding DoneToggleName}">
          <TextBlock Classes="caption subtle" Text="{Binding DoneText}" AutomationProperties.AccessibilityView="Raw" />
        </Button>
        <ItemsControl x:Name="WorkflowDoneRows" ItemsSource="{Binding DoneRows}" IsVisible="{Binding IsDoneExpanded}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="wf:InstanceRowViewModel">
              <wfv:InstanceRow />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Expander x:Name="WorkflowsKey" Margin="16,8" Header="{Binding LegendHeader}" IsExpanded="{Binding IsLegendOpen, Mode=TwoWay}">
          <Border x:Name="WorkflowsLegendName" AutomationProperties.Name="{Binding LegendName}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
            <TextBlock x:Name="WorkflowsLegend" Classes="caption subtle" Text="{Binding LegendText}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
          </Border>
        </Expander>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
