<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wf="using:Aw.Sindri.Ui.ViewModels.Workflows"
             xmlns:ctl="using:Aw.Sindri.Ui.Views.Controls"
             xmlns:comp="using:Aw.Sindri.Ui.Views.Components"
             x:Class="Aw.Sindri.Ui.Views.Workflows.InstanceRow"
             x:DataType="wf:InstanceRowViewModel">
  <!-- One row of the Workflows list (screens spec §4.2): the subject (a button: it opens the instance) with its served chip, the declared
       inputs with a check or a cross, a cell per state of the group's recipe, and the served now sentence. The name is the subject and
       the address. The row draws its own focus border (item-row), not the adorner. -->
  <Border x:Name="WorkflowRowFrame" Classes="item-row workflow-row" Classes.selected="{Binding IsSelected}" Classes.stale="{Binding IsStale}" Focusable="True"
          AutomationProperties.Name="{Binding AccessibleName}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="ListItem">
    <Grid x:Name="WorkflowRowGrid" ColumnDefinitions="220,150,*,180" VerticalAlignment="Top">
      <StackPanel Spacing="4" Margin="0,0,8,0">
        <Button x:Name="WorkflowRowOpen" Classes="row-title" Click="OnOpen" AutomationProperties.Name="{Binding OpenName}">
          <TextBlock Classes="body-strong" Text="{Binding Subject}" TextTrimming="CharacterEllipsis" AutomationProperties.AccessibilityView="Raw" />
        </Button>
        <ctl:StateChipView x:Name="WorkflowRowChip" Chip="{Binding Chip}" HorizontalAlignment="Left" />
        <!-- A protected answer is the lock, here in the row so A (and a click) reach its popover even where the columns are hidden. -->
        <comp:ProtectedActionButton x:Name="WorkflowProtected" DataContext="{Binding Protected}" HorizontalAlignment="Left"
                                    IsVisible="{Binding $parent[UserControl].((wf:InstanceRowViewModel)DataContext).Protected, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <!-- Behind a sheet the page is narrow: the row keeps the id, the title (the button above) and the state. -->
        <TextBlock x:Name="WorkflowRowCompact" Classes="caption mono subtle" Text="{Binding Compact}" IsVisible="False" TextTrimming="CharacterEllipsis"
                   AutomationProperties.AccessibilityView="Raw" />
      </StackPanel>
      <ItemsControl x:Name="WorkflowRowInputs" Grid.Column="1" ItemsSource="{Binding Inputs}" Margin="0,0,8,0">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="wf:InputCellViewModel">
            <Border Name="WorkflowInputCell" AutomationProperties.Name="{Binding Name}" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
              <TextBlock Classes="caption mono" TextTrimming="CharacterEllipsis" AutomationProperties.AccessibilityView="Raw">
                <Run Text="{Binding Label}" /><Run Text=" " /><Run Text="{Binding Mark}" />
              </TextBlock>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <ItemsControl x:Name="WorkflowRowStages" Grid.Column="2" ItemsSource="{Binding Cells}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="wf:StageCellViewModel">
            <Border Name="WorkflowStageCell" Margin="0,0,6,0" IsVisible="{Binding !IsMissing}" AutomationProperties.Name="{Binding Name}"
                    AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Text">
              <TextBlock Classes="caption mono" Classes.current="{Binding IsCurrent}" Text="{Binding Text}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock x:Name="WorkflowRowNow" Grid.Column="3" Classes="caption subtle" Text="{Binding Now}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                 AutomationProperties.Name="{Binding Now}" />
    </Grid>
  </Border>
</UserControl>
