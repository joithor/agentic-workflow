<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Aw.Sindri.Host (scaffolded by /new-package): the composition root and the minimal API endpoints
       (one per slice). Framework-dependent entry point 'sindri' (.agents/rules/csharp.md "AOT scope"; owner,
       2026-10-11, README X54): it hosts the Temporal worker through Aw.Sindri.Workflows, and the Temporal .NET SDK has
       no trimming or NativeAOT support (temporalio/sdk-dotnet#286), so this host is not an AwAotEntryPoint and never
       sets PublishAot. The only project that uses Infrastructure, in Composition. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <!-- Kept from the NativeAOT days on purpose: the host's code uses the invariant culture and ordinal comparisons
         throughout, and invariant globalization keeps the published host free of an ICU dependency on Linux. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The trim, AOT and single-file analyzers stay on (they add no package): nothing here publishes trimmed, but the
         host's own code stays free of reflection-only patterns, so going back to NativeAOT once the SDK supports it is
         a project-file change. -->
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <AssemblyName>sindri</AssemblyName>
    <RootNamespace>Aw.Sindri.Host</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Aw.Sindri.Core/Aw.Sindri.Core.csproj" />
    <ProjectReference Include="../Aw.Sindri.Features/Aw.Sindri.Features.csproj" />
    <ProjectReference Include="../Aw.Sindri.Infrastructure/Aw.Sindri.Infrastructure.csproj" />
    <ProjectReference Include="../Aw.Sindri.Workflows/Aw.Sindri.Workflows.csproj" />
    <ProjectReference Include="../../Aw.Kernel/Aw.Kernel.csproj" />
    <ProjectReference Include="../../Aw.Kernel.Telemetry/Aw.Kernel.Telemetry.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Aw.Sindri.Tests" />
  </ItemGroup>
</Project>
