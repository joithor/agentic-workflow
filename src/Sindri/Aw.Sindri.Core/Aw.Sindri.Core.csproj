<Project Sdk="Microsoft.NET.Sdk">
  <!-- Aw.Sindri.Core (scaffolded by /new-package): domain types, typed ids, value objects, pure logic, port
       interfaces and errors. No I/O, clock or random ids (BannedSymbols.txt, spec §4b.1). Sindri's domain: the host
       lease, ledger events, the profile and its approval, the schedule and the doctor's rules. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Aw.Sindri.Core</RootNamespace>
    <!-- RS0041: Vogen wraps a Guid id's generated ToString(string, IFormatProvider) in #nullable disable, with nothing to
         fix in user code (docs/csharp/typed-ids.md, "Public ids and PublicAPI files"); first Guid ids: CommandId, CorrelationId. -->
    <NoWarn>$(NoWarn);RS0041</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Vogen" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../Aw.Kernel/Aw.Kernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Aw.Sindri.Tests" />
    <InternalsVisibleTo Include="Aw.Sindri.Engine.Tests" />
    <InternalsVisibleTo Include="Aw.Sindri.Testing" />
  </ItemGroup>
</Project>
