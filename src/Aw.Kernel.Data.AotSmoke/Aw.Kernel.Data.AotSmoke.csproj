<Project Sdk="Microsoft.NET.Sdk">
  <!-- NativeAOT canary for Aw.Kernel.Data: run.sh publishes it with PublishAot, fails on any trim/AOT (IL2xxx/IL3xxx)
       warning, runs the native binary against a temp database and compares its stdout with expected.txt. It covers
       the reflection-adjacent paths (embedded migration resources, the generated file-name regex) and the binders.
       Under src/, not tests/: it is not a *.Tests project (AW0002). InvariantGlobalization, as on every AOT tool. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Aw.Kernel.Data/Aw.Kernel.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Migrations/*.sql" />
  </ItemGroup>
</Project>
