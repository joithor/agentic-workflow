<Project Sdk="Microsoft.NET.Sdk">
  <!-- Aw.Kernel.Data: tier 0 (deps.yaml), Aw.Kernel plus one external dependency, Microsoft.Data.Sqlite
       (spec §4b.1). Hand-written ADO.NET with an IRowMapper<T> per row type, the unit of work, and the
       migrations runner (spec §4b.2; decision R8 in docs/readiness/aot-spike.md). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Aw.Kernel.Data</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Aw.Kernel/Aw.Kernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Aw.Kernel.Data.Tests" />
  </ItemGroup>
</Project>
