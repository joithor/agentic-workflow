<Project Sdk="Microsoft.NET.Sdk">
  <!-- Aw.Meta.Host (scaffolded by /new-package): the composition root and the CLI commands
       (one per slice). NativeAOT entry point 'aw-meta' (spec §4b.6); the only project that uses Infrastructure, in
       Composition. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AwAotEntryPoint>true</AwAotEntryPoint>
    <PublishAot Condition="'$(RuntimeIdentifier)' != ''">true</PublishAot>
    <AssemblyName>aw-meta</AssemblyName>
    <RootNamespace>Aw.Meta.Host</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Aw.Meta.Core/Aw.Meta.Core.csproj" />
    <ProjectReference Include="../Aw.Meta.Features/Aw.Meta.Features.csproj" />
    <ProjectReference Include="../Aw.Meta.Infrastructure/Aw.Meta.Infrastructure.csproj" />
    <ProjectReference Include="../../Aw.Kernel/Aw.Kernel.csproj" />
    <ProjectReference Include="../../Aw.Kernel.Telemetry/Aw.Kernel.Telemetry.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Aw.Meta.Tests" />
  </ItemGroup>
</Project>
