<Project Sdk="Microsoft.NET.Sdk">
  <!-- NativeAOT byte-compat smoke for Aw.Kernel's Node JSON profile (spec §4c). run.sh publishes it with PublishAot,
       runs the native binary and compares its stdout with node-expected.mjs byte for byte. R1a's AOT CI job runs it.
       It lives under src/, not tests/: it is not a *.Tests project (AW0002), and the full library rule set applies.
       InvariantGlobalization: Kernel formats and parses with InvariantCulture only, and a Linux AOT binary would
       otherwise need libicu at run time. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Aw.Kernel/Aw.Kernel.csproj" />
  </ItemGroup>
</Project>
