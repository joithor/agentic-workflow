<Project Sdk="Microsoft.NET.Sdk">
  <!-- Aw.Packets.App (scaffolded by /new-package, small shape): features, infrastructure and the CLI host in one
       project, with the same dependency direction by namespace (spec §4b.1; ARCH-* in tests/Aw.Architecture.Tests).
       Nothing outside the package references it, so its types are internal (CA1515). NativeAOT entry point 'aw-packets'. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <PublishAot>true</PublishAot>
    <AssemblyName>aw-packets</AssemblyName>
    <RootNamespace>Aw.Packets.App</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Aw.Packets.Core/Aw.Packets.Core.csproj" />
    <ProjectReference Include="../../Aw.Kernel/Aw.Kernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Aw.Packets.Tests" />
    <InternalsVisibleTo Include="Aw.Packets.Testing" />
  </ItemGroup>
</Project>
