{
  // The human development environment (readiness spec §4d, §6 W5). Never the agent sandbox:
  // no Docker-in-Docker, no host Docker socket, no privileged mode. See docs/devcontainer.md.
  "name": "agentic-workflow",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "remoteUser": "ubuntu",
  "containerEnv": {
    "AW_STATE_DIR": "/home/ubuntu/.agentic-workflow",
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
    "DOTNET_NOLOGO": "1",
    "AVALONIA_TELEMETRY_OPTOUT": "1"
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit",
        "editorconfig.editorconfig",
        "timonwong.shellcheck"
      ]
    }
  }
}
