<Project>
  <!-- Build settings for every C# project under this repo (agent-readiness spec §4b.6).
       Analyzer severities live in .editorconfig; package versions in Directory.Packages.props;
       the CI lock-file guard in Directory.Build.targets. -->

  <PropertyGroup Label="Language">
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup Label="Warnings and analyzers">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <MSBuildTreatWarningsAsErrors>true</MSBuildTreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- The pinned Microsoft.CodeAnalysis.NetAnalyzers package (Directory.Packages.props) owns the CA rules.
         With the SDK's built-in copy also on, every CA diagnostic is reported twice. Code-style (IDE) rules
         still run from the SDK through EnforceCodeStyleInBuild.
         There is deliberately no AnalysisLevel/AnalysisMode here: the SDK wires those through a targets file it
         imports only when EnableNETAnalyzers is true, and the package ships no build/ folder, so they would be
         silently ignored. Severity comes from .editorconfig instead: the bulk `error` baseline plus explicit
         per-rule and per-category lines. -->
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <!-- Public API carries XML docs; IDE0005 (unused usings) also needs the documentation file to run in build. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- NuGet audit (spec §4d): advisory data is fetched live, so with warnings as errors any new advisory would turn
       every branch red with no change in the repo. High and critical advisories (NU1903, NU1904) fail the build;
       low and moderate (NU1901, NU1902) stay visible warnings and are left to Dependabot. NU1900 (the advisory feed
       could not be read) stays an error, so the high/critical gate is never silently skipped: a persistent
       advisory-feed outage is a deliberate red build; restore is retried once (scripts/dotnet-verify-packages.sh). -->
  <PropertyGroup Label="NuGet audit">
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902</WarningsNotAsErrors>
  </PropertyGroup>

  <PropertyGroup Label="Reproducible output">
    <Deterministic>true</Deterministic>
    <!-- The C# build lands in its own directory (artifacts/), never next to the TS build (spec §4c). -->
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>
  </PropertyGroup>

  <PropertyGroup Label="Lock files">
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <!-- CI (GitHub Actions sets CI=true). Locked mode fails restore when a project's package references no longer
       match its packages.lock.json (NU1004). It does not fail on a missing or hand-edited lock file: the
       AwRequireLockFile target (Directory.Build.targets) fails on a missing one, and
       scripts/dotnet-verify-packages.sh fails when restore changed a committed one. Restore with
       the force-evaluate option bypasses locked mode (drift exits 0 and rewrites the lock file): no CI step may use it. -->
  <PropertyGroup Label="CI" Condition="'$(CI)' == 'true'">
    <RestoreLockedMode>true</RestoreLockedMode>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Project roles, from the project name (spec §4b.1). -->
  <PropertyGroup Label="Project roles">
    <_AwName>$(MSBuildProjectName)</_AwName>
    <AwIsTestProject Condition="$(_AwName.EndsWith('.Tests')) or $(_AwName.EndsWith('.Testing'))">true</AwIsTestProject>
    <AwIsHostProject Condition="$(_AwName.EndsWith('.Host'))">true</AwIsHostProject>
    <AwIsAnalyzerProject Condition="$(_AwName.EndsWith('.Analyzers'))">true</AwIsAnalyzerProject>
    <AwIsCoreProject Condition="$(_AwName.EndsWith('.Core'))">true</AwIsCoreProject>
    <!-- Every other project is a library (Core, Features, Infrastructure, App, Kernel, Redaction, ...). A new
         project shape is covered by default. Libraries get IsAotCompatible in Directory.Build.targets (it must be
         evaluated after the .csproj, so an AwAotCompatible=false opt-out there is seen). -->
    <AwIsLibraryProject Condition="'$(AwIsTestProject)' != 'true' and '$(AwIsHostProject)' != 'true' and '$(AwIsAnalyzerProject)' != 'true'">true</AwIsLibraryProject>
    <!-- Core projects have no I/O, clock or random ids (spec §4b.1). Other projects may opt in with AwBannedSymbols=true. -->
    <AwBannedSymbols Condition="'$(AwBannedSymbols)' == '' and '$(AwIsCoreProject)' == 'true'">true</AwBannedSymbols>
    <!-- Every production project (Core, Features, Infrastructure, App, Host, Kernel, ...) gets BannedSymbols.All.txt
         (blocking waits, TaskCompletionSource continuations); every one but a Host also gets
         BannedSymbols.NonHost.txt (Environment.Exit, GC.Collect); only a project named *.Host counts as a Host. Test projects get
         BannedSymbols.Tests.txt (the wall clock, Guid.NewGuid and Thread.Sleep; Aw.Kernel.Testing's RealTime is the one exception). -->
    <AwBannedSymbolsAll Condition="'$(AwIsTestProject)' != 'true' and '$(AwIsAnalyzerProject)' != 'true'">true</AwBannedSymbolsAll>
    <AwBannedSymbolsNonHost Condition="'$(AwBannedSymbolsAll)' == 'true' and '$(AwIsHostProject)' != 'true'">true</AwBannedSymbolsNonHost>
    <AwBannedSymbolsTests Condition="'$(AwIsTestProject)' == 'true'">true</AwBannedSymbolsTests>
  </PropertyGroup>

  <!-- Test projects (*.Tests, and the *.Testing fakes, builders and contract bases) live under tests/. Their
       analyzer policy is tests/.editorconfig (it wins over the root file there). GenerateDocumentationFile stays
       on, so IDE0005 (unused usings) still runs; tests/.editorconfig turns off CS1591 instead. -->
  <PropertyGroup Condition="'$(AwIsTestProject)' == 'true'">
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup Condition="'$(AwBannedSymbols)' == 'true'">
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" Link="BannedSymbols.txt" />
  </ItemGroup>
  <ItemGroup Condition="'$(AwBannedSymbolsAll)' == 'true'">
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.All.txt" Link="BannedSymbols.All.txt" />
  </ItemGroup>
  <ItemGroup Condition="'$(AwBannedSymbolsNonHost)' == 'true'">
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.NonHost.txt" Link="BannedSymbols.NonHost.txt" />
  </ItemGroup>
  <ItemGroup Condition="'$(AwBannedSymbolsTests)' == 'true'">
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.Tests.txt" Link="BannedSymbols.Tests.txt" />
  </ItemGroup>

  <!-- CA1502 (cyclomatic complexity) reads its limit from here. -->
  <ItemGroup>
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)CodeMetricsConfig.txt" Link="CodeMetricsConfig.txt" />
  </ItemGroup>

  <!-- Public API tracking (spec §4b.3): PublicAPI.Shipped.txt and PublicAPI.Unshipped.txt next to the .csproj.
       The analyzer reports RS0016 for every public symbol of a project that has no such files, so a library
       can't opt out by forgetting them (do not set dotnet_public_api_analyzer.require_api_files = true: that
       silences the analyzer when the files are missing). Test projects turn it off in tests/.editorconfig. -->
  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" Condition="Exists('PublicAPI.Shipped.txt')" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" Condition="Exists('PublicAPI.Unshipped.txt')" />
  </ItemGroup>
</Project>
