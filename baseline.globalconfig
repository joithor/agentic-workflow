# Ratchet baseline (agent-readiness spec §4b.6).
#
# Existing analyzer violations are recorded here as rule-and-file pairs that lower ONLY that rule for
# ONLY that file. It may only shrink: CI fails if a line is added (the check lands with the ratchet job).
# New code never gets an entry; fix the violation instead.
#
# Format (one block per file):
#   [src/Pkg/Pkg.Core/SomeFile.cs]
#   dotnet_diagnostic.MA0051.severity = none   # existing: 52-line method, split tracked in <item>
is_global = true
global_level = 100
