<Project>
  <!-- Exact pins ([x.y.z]), each published at least 14 days before 2026-10-09. Dates, including every transitive
       package in the committed packages.lock.json files: scripts/nuget-dates.py with the lock option over every packages.lock.json. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="[10.0.12]" />
    <PackageVersion Include="Microsoft.Data.Sqlite.Core" Version="[10.0.12]" />
    <PackageVersion Include="SQLitePCLRaw.provider.sqlite3" Version="[2.1.12]" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="[10.0.12]" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="[10.0.12]" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Tasks" Version="[10.0.12]" />
    <PackageVersion Include="Dapper" Version="[2.1.89]" />
    <PackageVersion Include="Dapper.AOT" Version="[1.1.0]" />
    <PackageVersion Include="Vogen" Version="[8.0.7]" />
    <PackageVersion Include="ModelContextProtocol" Version="[2.2.0]" />
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="[2.2.0]" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="[10.0.12]" />
    <PackageVersion Include="xunit.v3" Version="[4.0.1]" />
    <PackageVersion Include="TUnit" Version="[1.69.0]" />
  </ItemGroup>
</Project>
