<Project>
  <!-- Spikes are throwaway measurement code for docs/readiness/aot-spike.md.
       This file deliberately does NOT import any parent Directory.Build.props, so the
       spikes never inherit (or affect) the repo's product build settings. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">osx-arm64</RuntimeIdentifier>
  </PropertyGroup>
</Project>
