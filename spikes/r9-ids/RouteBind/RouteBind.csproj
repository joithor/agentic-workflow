<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- R9 probe: bind Vogen hybrid ids from the route on CreateSlimBuilder with the request-delegate generator. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PublishAot>true</PublishAot>
    <RootNamespace>Spike.R9</RootNamespace>
    <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../VogenHybrid/Ids.cs" />
    <PackageReference Include="Vogen" />
  </ItemGroup>
</Project>
