<Project Sdk="Microsoft.NET.Sdk">
  <!-- R8 probe: with Dapper's assembly-level IL2104/IL3053 suppressed (the "narrow" fix), what happens to a
       query the Dapper.AOT generator cannot intercept? -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PublishAot>true</PublishAot>
    <RootNamespace>Spike.R8</RootNamespace>
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Dapper.AOT</InterceptorsNamespaces>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);IL2104;IL3053</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Dapper" />
    <PackageReference Include="Dapper.AOT" />
  </ItemGroup>
</Project>
