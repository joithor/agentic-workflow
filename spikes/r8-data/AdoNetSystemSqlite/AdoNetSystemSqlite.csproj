<Project Sdk="Microsoft.NET.Sdk">
  <!-- R8 variant (a'): ADO.NET over the OS libsqlite3 (SQLitePCLRaw provider.sqlite3) instead of the bundled
       e_sqlite3, so the AOT binary is one file. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PublishAot>true</PublishAot>
    <RootNamespace>Spike.R8</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Scenario.cs" />
    <PackageReference Include="Microsoft.Data.Sqlite.Core" />
    <PackageReference Include="SQLitePCLRaw.provider.sqlite3" />
  </ItemGroup>
</Project>
