<Project>
  <!-- Central Package Management (agent-readiness spec §4b.6, §4d). Each version we choose lives here, is pinned
       exactly ([x.y.z]; a bare version means "x.y.z or newer"), and is at least 14 days old when pinned (the repo's
       existing pin policy). Packages the SDK adds implicitly (Microsoft.NET.ILLink.Tasks, from IsAotCompatible)
       carry an open range and are pinned only by packages.lock.json. Analyzers run code in every build, so they get
       the same review as runtime dependencies. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- Analyzers in every project. Severities and the one owner per overlapping rule: .editorconfig. -->
  <ItemGroup Label="Analyzers">
    <GlobalPackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="[10.0.401]" />
    <GlobalPackageReference Include="Meziantou.Analyzer" Version="[3.0.290]" />
    <GlobalPackageReference Include="Roslynator.Analyzers" Version="[5.0.0]" />
    <GlobalPackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="[5.6.0]" />
    <GlobalPackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="[5.6.0]" />
  </ItemGroup>

  <ItemGroup Label="Packages">
    <!-- Tests. xunit.v3 4.0.1 published 2026-09-12. -->
    <PackageVersion Include="xunit.v3" Version="[4.0.1]" />
    <!-- Aw.Kernel.Testing's one external dependency; the same exact version xunit.v3 4.0.1 pins. Published 2026-09-12. -->
    <PackageVersion Include="xunit.v3.extensibility.core" Version="[4.0.1]" />
    <!-- FakeTimeProvider for test projects (spec §4b.4, §4b.5). 10.10.0 published 2026-09-09. -->
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="[10.10.0]" />
    <!-- Data (Aw.Kernel.Data, decision R8). Microsoft.Data.Sqlite 10.0.12 published 2026-09-08; it bundles e_sqlite3,
         which ships as a libe_sqlite3 file beside each AOT tool (docs/csharp/kernel-data.md). -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="[10.0.12]" />
    <!-- Typed ids (decision R9, docs/csharp/typed-ids.md). Vogen 8.0.7 published 2026-07-21. -->
    <PackageVersion Include="Vogen" Version="[8.0.7]" />
    <!-- Telemetry (Aw.Kernel.Telemetry's one external dependency, spec §4b.1): spans, metrics and the processor and
         exporter seams. OpenTelemetry 1.19.1 published 2026-09-21. It brings Microsoft.Extensions.Logging,
         .Configuration (with the EnvironmentVariables provider), .Options and .DependencyInjection transitively (pinned
         by the lock files; nothing may use IConfiguration). No exporter package: exporting is off by default and an
         exporter is an adapter the host opts into (docs/csharp/telemetry.md). -->
    <PackageVersion Include="OpenTelemetry" Version="[1.19.1]" />
  </ItemGroup>
</Project>
